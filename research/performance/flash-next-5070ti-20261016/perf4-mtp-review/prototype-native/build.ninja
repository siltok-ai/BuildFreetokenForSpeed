ninja_required_version = 1.3
cxx = cl
cxxflags = /std:c++20 /MD /EHsc /wd4819 /wd4251 /wd4244 /wd4267 /wd4275 /wd4018 /wd4190 /wd4624 /wd4067 /wd4068 -IC$:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\tvm_ffi\include -IC$:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\tvm_ffi\include -IC$:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\freetoken\kernel\csrc\include -IC$:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\freetoken\kernel\csrc\third_party\strata_mmvq\include -IC$:\workspace\build\freetoken-mats\flash-perf-materials-03\candidate-source\build-source\tools\windows-compat
nvcc = C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.2\bin\nvcc
cuda_cflags = -Xcompiler=/std:c++20,/O2 -std=c++20 -O3 --expt-relaxed-constexpr --use_fast_math -D__always_inline=__forceinline__ -gencode=arch=compute_120,code=compute_120 -IC$:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\tvm_ffi\include -IC$:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\tvm_ffi\include -IC$:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\freetoken\kernel\csrc\include -IC$:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\freetoken\kernel\csrc\third_party\strata_mmvq\include -IC$:\workspace\build\freetoken-mats\flash-perf-materials-03\candidate-source\build-source\tools\windows-compat
ldflags = /DLL /LIBPATH:C:\workspace\envs\siltok-speed\flash-perf-cand3\Lib\site-packages\tvm_ffi\lib tvm_ffi.lib /LIBPATH:"C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.2\lib\x64" cudart.lib

rule compile
  command = $cxx /showIncludes $cxxflags -c $in /Fo$out
  deps = msvc

rule compile_cuda
  depfile = $out.d
  deps = gcc
  command = $nvcc  --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out

rule link
  command = $cxx $in /link $ldflags /out:$out

build cuda_0.o: compile_cuda C$:\workspace\build\freetoken-mats\flash-perf-mapped-head-01\cuda.cu
build freetoken__gguf_q5_subset_proto4_r1.dll: link cuda_0.o

default freetoken__gguf_q5_subset_proto4_r1.dll
