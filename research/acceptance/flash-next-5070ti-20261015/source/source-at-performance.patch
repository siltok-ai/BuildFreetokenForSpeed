 ## Register a model
 
+The historical Strata presets reserve 9216 experts with MTP off, or 7168 with
+MTP on, for the tested 24 GiB machine. Smaller positive capacities are accepted
+when both `vram_estimate_bytes` and `host_commit_estimate_bytes` are explicit.
+Keep `moe_q2_dynamic_slots=1024` and `moe_cache_size=moe_q2_resident_experts+2048`.
+Each expert occupies 1,382,400 compressed bytes: the GPU bank has the configured
+total slots, and the pinned host bank owns the complement of the permanent
+experts. Budgets below those ownership bytes are rejected; those floors exclude
+the rest of the model and runtime overhead and are insufficient as admission
+estimates. Measure the complete workload before choosing deployment budgets.
+The machine's resource probe and safety margins still apply. This capacity
+interface alone does not certify a particular GPU or performance level.
+
 Use `FreeTokenQwen36Backend` for new manifests. Existing manifests that name
 `Qwen36Backend` resolve to the same implementation.
 
diff --git a/tests/unit/test_freetoken_strata_q2.py b/tests/unit/test_freetoken_strata_q2.py
index 53e60893..ce23d479 100644
--- a/tests/unit/test_freetoken_strata_q2.py
+++ b/tests/unit/test_freetoken_strata_q2.py
@@ -73,6 +73,36 @@ def test_public_smoke_manifest_preserves_complete_q2_residency(tmp_path, monkeyp
     assert options.moe_cache_size == 2*512 + options.moe_q2_dynamic_slots + options.moe_q2_resident_experts
 
 
+@pytest.mark.parametrize('resident', [512, 1024, 2048])
+def test_custom_residency_reaches_native_config_with_explicit_budgets(tmp_path, monkeypatch, resident):
+    """小显存几何必须传到真实引擎配置，同时要求调用者提供独立资源预算。"""
+    from freetoken.distributed import DistributedInfo
+    from freetoken.scheduler.config import SchedulerConfig
+    _checkpoint(tmp_path, monkeypatch)
+    checkpoint = contract.inspect_freetoken_checkpoint(tmp_path)
+    geometry = dict(moe_q2_resident_experts=resident, moe_cache_size=resident + 2048)
+    budgets = dict(vram_estimate_bytes=14 * 1024**3, host_commit_estimate_bytes=36 * 1024**3)
+    with pytest.raises(ValueError, match='explicit.*budget'):
+        _runtime_options(checkpoint, BackendConfig(extra=geometry))
+    args = Namespace(profile='flash-next', model=tmp_path, quant='q2_0_strata',
+        protected_experts=resident, startup_timeout=300, request_timeout=1800, shutdown_timeout=20,
+        vram_estimate_gib=14, host_commit_estimate_gib=36)
+    manifest = _manifest(args, 'custom-flash-next')
+    options = _runtime_options(checkpoint, BackendConfig(extra=manifest['models'][0]['engine']['extra']))
+    payload = _worker_option_payload(options)
+    worker._worker_options({'options': payload})
+    native = SchedulerConfig(model_path='configuration-only', tp_info=DistributedInfo(0, 1),
+                             **worker._llm_kwargs(payload))
+    assert native.moe_q2_resident_experts == resident
+    assert native.moe_cache_size == resident + 2048
+    for missing in budgets:
+        with pytest.raises(ValueError, match='explicit.*budget'):
+            _runtime_options(checkpoint, BackendConfig(extra=geometry | {k:v for k,v in budgets.items() if k != missing}))
+    for too_small in budgets:
+        with pytest.raises(ValueError, match='compressed expert'):
+            _runtime_options(checkpoint, BackendConfig(extra=geometry | budgets | {too_small: 1}))
+
+
