    def test_discovery_vision_registers_vlm_backend_on_chat_pipeline(tmp_path):
        """Vision (Qwen2.5-VL) entries must:
          - Resolve artifacts.weights.path against models_dir
          - Register the model with VLMBackend (not KTLLMBackend)
          - Register the ChatPipeline class under name "chat"
          - Forward engine.extra into BackendConfig.extra so VLMBackend can read
            gpu_budget / cpu_budget / min_pixels / max_pixels / target_fps at
            load time
    
        Locks the discovery contract for R9; without it a regression that
        shipped `_register_chat` for type=="vision" would silently route
        Qwen2.5-VL through KTLLMBackend (which does not understand video) and
        appear as a runtime error only when the first multimodal request
        arrived.
        """
        weights_dir = tmp_path / "vision" / "qwen2.5-vl-7b-instruct.bf16"
        _write_hf_model_dir(weights_dir, {"torch_dtype": "bfloat16"})
    
        extra_block = {
            "gpu_budget": "10GiB",
            "cpu_budget": "60GiB",
            "min_pixels": 200704,
            "max_pixels": 401408,
            "target_fps": 2.0,
        }
    
        (tmp_path / "manifest.json").write_text(
            json.dumps({
                "schema": SCHEMA,
                "models": [
                    {
                        "id": "qwen2.5-vl-7b-instruct.bf16",
                        "name": "Qwen2.5 VL 7B",
                        "type": "vision",
                        "family": "qwen-vl",
                        "features": ["vision"],
                        "engine": {
                            "pipeline": "chat",
                            "backend": "VLMBackend",
                            "extra": extra_block,
                        },
                        "artifacts": {
                            "weights": {
                                "path": "vision/qwen2.5-vl-7b-instruct.bf16",
                                "layout": "hf_model",
                            },
                        },
                    },
                ],
            }),
