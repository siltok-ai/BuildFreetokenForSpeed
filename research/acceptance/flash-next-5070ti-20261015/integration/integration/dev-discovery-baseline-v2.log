tmp_path = WindowsPath('C:/Users/UserPC/AppData/Local/Temp/pytest-of-userpc/pytest-12/test_discovery_vision_without_0')

    def test_discovery_vision_without_engine_backend_is_rejected(tmp_path):
        """Manifest contract (model-management-spec.md §5): a `type=vision`
        entry under `pipeline=chat` MUST declare `engine.backend="VLMBackend"`.
        Discovery must reject the entry up-front instead of silently routing
        Qwen2.5-VL through KTLLMBackend (which does not understand video) and
        only failing on the first multimodal request."""
        weights_dir = tmp_path / "vision" / "qwen2.5-vl-7b-instruct.bf16"
        _write_hf_model_dir(weights_dir)
    
        (tmp_path / "manifest.json").write_text(
            json.dumps({
                "schema": SCHEMA,
                "models": [
                    {
                        "id": "qwen2.5-vl-7b-instruct.bf16",
                        "name": "Qwen2.5 VL 7B",
                        "type": "vision",
                        "family": "qwen-vl",
                        "features": ["vision"],
                        "engine": {
                            "pipeline": "chat",
                            # NOTE: engine.backend deliberately omitted to
                            # exercise the validation path.
                            "extra": {"gpu_budget": "10GiB"},
                        },
                        "artifacts": {
                            "weights": {
                                "path": "vision/qwen2.5-vl-7b-instruct.bf16",
                                "layout": "hf_model",
                            },
                        },
                    },
                ],
            }),
            encoding="utf-8",
        )
    
        engine = _engine(tmp_path)
    
        with pytest.raises(ValueError, match="engine.backend must be 'VLMBackend'"):
>           discover_and_register(
                engine, str(tmp_path), yaml_base_dir=str(tmp_path),
            )

