<!--
  WinSW service definition for Siltok Speed.

  Declarative replacement for the imperative `nssm set ...` sequence used today
  (Windows 多机部署.md §3/§4). This file ships verbatim next to SiltokSpeed.exe
  (the renamed WinSW binary); the file name stem must match the exe stem.

  WinSW expands %BASE% (dir of the exe) and %ProgramData% at runtime, so this
  XML is SKU-independent and needs no install-time rendering. SKU-specific
  tuning lives in versioned release intent plus an optional operator override,
  not here.

  Install / control:
    SiltokSpeed.exe install      (register, auto-start)
    SiltokSpeed.exe start | stop | restart | status
    SiltokSpeed.exe uninstall    (stop + remove)
-->
<service>
  <id>SiltokSpeed</id>
  <name>Siltok Speed</name>
  <description>Siltok Speed unified inference engine (Chat / Video / Image).</description>
  <!-- WinSW must own the long-lived Python process directly. A cmd.exe batch
       parent remains alive after Python handles WinSW's stop signal, forcing
       every service stop to wait for stoptimeout and racing Stop-Service's
       own timeout. The release-profile entry renders the validated runtime
       config before starting the HTTP server. -->
  <executable>%BASE%\python\python.exe</executable>
  <arguments>-X utf8 -B -m silitok_speed.release_profile serve --config-root "%ProgramData%\Siltok\Speed\config" --runtime-dir "%ProgramData%\Siltok\Speed\runtime"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <env name="PATH" value="%BASE%\python\Scripts;%PATH%" />
  <!-- 安装包内置的 FreeToken AOT kernel cache（17 DLL）。env 优先级高于
       config.yaml，安装机开箱即用；换 cache 目录时改此值或删掉此行后用
       service.freetoken_kernel_cache_dir 配置。 -->
  <env name="SILITOK_FREETOKEN_KERNEL_CACHE_DIR" value="%BASE%\runtime\kernel-cache" />
  <startmode>Automatic</startmode>
  <!-- Crash auto-restart (equivalent to NSSM AppExit Default Restart). -->
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
  <!-- WinSW can capture the managed process's stdout/stderr. Python ALSO
       redirects its own fd 1/2 to SILITOK_LOG_DIR via observability; these
       WinSW logs are the outer wrapper view (startup / early traceback). -->
  <logpath>%ProgramData%\Siltok\Speed\logs</logpath>
  <!-- mode=none: do NOT capture the child's stdout/stderr via a WinSW pipe.
       serve.py redirects its own fd 1/2 to SILITOK_LOG_DIR\stdout.log; once it
       does, the WinSW capture pipe hits EOF and WinSW (mis)reads that as the
       process exiting -> it restarts a duplicate that then can't bind the port
       -> RUNNING/STOPPED flap (one good instance serves, duplicates churn).
       With no pipe, WinSW tracks Python by handle and stays stable.
       Real logs still land in SILITOK_LOG_DIR\stdout.log + siltok.log. -->
  <log mode="none" />
  <stoptimeout>30 sec</stoptimeout>
  <env name="TRITON_CACHE_DIR" value="C:\workspace\cache\triton\installed-i04" />
  <env name="FREETOKEN_DISABLE_JIT" value="1" />
  <env name="FREETOKEN_KERNEL_CACHE_DIR" value="C:\workspace\build\siltok-speed\i04\runtime\kernel-cache" />
  <env name="HF_HOME" value="C:\workspace\cache\hf" />
  <env name="TORCH_EXTENSIONS_DIR" value="C:\workspace\cache\ext\installed-i04" />
</service>