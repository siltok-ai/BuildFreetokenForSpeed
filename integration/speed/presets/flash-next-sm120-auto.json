{
  "format": 1,
  "name": "sm120-auto",
  "scope": "Speed selects its existing SM120 16GiB/32GiB tier from hardware; no fixed capacity overrides. OFF remains the recommended default.",
  "required_version": "0.1.3+speed.mtpdecode2",
  "resource_profile": "auto",
  "startup_timeout_seconds": 600,
  "runtime_extra": {
    "linear_state_cache_slots": 1,
    "moe_q2_adapt_every": 32,
    "moe_q2_adapt_decay": 0.7,
    "gguf_embedding_host": true,
    "ple_row_cache_rows": 1048576,
    "moe_q2_prefill_workspace": true,
    "fixed_q2_rebuild_reserve_mib": 0
  },
  "compact_mtp": true,
  "resource": {
    "gpu_probe": "nvml",
    "vram_safety_gb": 0.25,
    "commit_safety_gb": 4
  },
  "modes": {
    "off": {},
    "on": {}
  },
  "mtp_draft_policy": "paired_cjk"
}
