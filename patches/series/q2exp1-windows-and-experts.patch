new file mode 100644
--- /dev/null
+++ b/python/freetoken/layers/quantization/moe/q2_0.py
@@ -0,0 +1,49 @@
+"""GSQ Q2_0 routed experts, kept in their native 64-element / 18-byte blocks."""
+from __future__ import annotations
+
+import torch
+
+from ..registry import LayerKind, register_method
+from ..scheme import QuantKind
+from .base import BankSpec, MoEConfig, MoEKernel, MoEMethod
+
+
+class TritonQ20MoEKernel(MoEKernel):
+    name = "triton"
+
+    def unusable_reason(self, cfg: MoEConfig):
+        reason = self._common_reject(cfg, tp_ok=False, cpu_ok=False, plain_silu_only=True)
+        if reason:
+            return reason
+        if cfg.interleaved or cfg.apply_router_weight_on_input:
+            return "Q2_0 requires contiguous gate/up halves and output-side routing weights"
+        if cfg.hidden % 64 or cfg.intermediate % 64:
+            return "Q2_0 input dimensions must be divisible by 64"
+        if cfg.strategy != "offload":
+            return "Q2_0 currently requires pure GPU offload"
+        if cfg.dtype != torch.bfloat16:
+            return "Q2_0 mixed-precision path currently requires BF16 activations"
+        return None
+
+    def layout(self, cfg):
+        return {
+            "gate_up": BankSpec((2 * cfg.intermediate, cfg.hidden // 64 * 18), torch.uint8),
+            "down": BankSpec((cfg.hidden, cfg.intermediate // 64 * 18), torch.uint8),
+        }
+
+    def pack(self, pieces, cfg, out):
+        # 原生量化字节直接填入 bank，禁止创建整层 BF16 专家副本。
+        out["gate_up"][:, :cfg.intermediate].copy_(pieces["gate"])
+        out["gate_up"][:, cfg.intermediate:].copy_(pieces["up"])
+        out["down"].copy_(pieces["down"])
+        return {}
+
+    def apply(self, layer, x, topk_weights, topk_ids, view, *, is_prefill):
+        from freetoken.moe.fused_q2_0 import fused_experts_q2_0
+
+        return fused_experts_q2_0(x, view.tensors["gate_up"], view.tensors["down"], topk_weights, topk_ids)
+
+
+@register_method(QuantKind.Q2_0, LayerKind.MOE)
+class Q20MoEMethod(MoEMethod):
+    candidates = (TritonQ20MoEKernel,)
diff --git a/python/freetoken/models/qwen4_exp/q2_source.py b/python/freetoken/models/qwen4_exp/q2_source.py
new file mode 100644
--- /dev/null
+++ b/python/freetoken/models/qwen4_exp/q2_source.py
@@ -0,0 +1,144 @@
+"""Expert-only GGUF v3 source; deliberately independent of GGUF trunk/PLE readers."""
+from __future__ import annotations
+
+import math
+from pathlib import Path
+import re
+import struct
+
+import torch
+
+SOURCE_SHA256 = "69820c02ec7d0b45ef2ebb19d6620299db749fe2aded7f39f93c6b88b199b720"
+SOURCE_SIZE = 37_623_740_192
+_FORMATS = {0: "B", 1: "b", 2: "H", 3: "h", 4: "I", 5: "i", 6: "f", 7: "?", 10: "Q", 11: "q", 12: "d"}
+
+
+def _read(stream, count):
+    data = stream.read(count)
+    if len(data) != count:
+        raise ValueError("truncated GGUF expert source")
+    return data
+
+
+def _unpack(stream, fmt):
+    return struct.unpack("<" + fmt, _read(stream, struct.calcsize("<" + fmt)))
+
+
+def _string(stream):
+    size, = _unpack(stream, "Q")
+    if size > 16 << 20:
+        raise ValueError("oversized GGUF string")
+    return _read(stream, size).decode("utf-8")
+
+
+def _value(stream, kind=None, *, keep=True):
+    if kind is None:
+        kind, = _unpack(stream, "I")
+    if kind == 8:
+        return _string(stream)
+    if kind == 9:
+        elem, count = _unpack(stream, "IQ")
+        if count > 10_000_000:
+            raise ValueError("oversized GGUF metadata array")
+        if not keep and elem in _FORMATS:
+            stream.seek(count * struct.calcsize("<" + _FORMATS[elem]), 1)
+            return None
+        values = [_value(stream, elem, keep=keep) for _ in range(count)]
+        return values if keep else None
+    if kind not in _FORMATS:
+        raise ValueError(f"unsupported GGUF metadata type {kind}")
+    return _unpack(stream, _FORMATS[kind])[0]
+
+
+def read_q2_directory(path: Path, *, layers=48, experts=512, hidden=2560, intermediate=640):
+    """Validate every expert shape/type/bound and return absolute tensor offsets."""
+    metadata, directory = {}, {}
+    with path.open("rb") as stream:
+        magic, version, tensors, values = _unpack(stream, "IIQQ")
+        if magic != 0x46554747 or version != 3 or tensors > 100_000 or values > 100_000:
+            raise ValueError("invalid GGUF v3 header")
+        for _ in range(values):
+            key = _string(stream)
+            value = _value(stream, keep=not key.startswith("tokenizer."))
+            if not key.startswith("tokenizer."):
+                metadata[key] = value
+        for _ in range(tensors):
+            name = _string(stream)
+            dims, = _unpack(stream, "I")
+            if not 1 <= dims <= 4:
+                raise ValueError("invalid GGUF tensor rank")
+            shape = _unpack(stream, "Q" * dims)
+            kind, offset = _unpack(stream, "IQ")
+            if name in directory:
+                raise ValueError(f"duplicate GGUF tensor {name}")
+            directory[name] = (shape, kind, offset)
+        alignment = int(metadata.get("general.alignment", 32))
+        if alignment <= 0 or alignment & (alignment - 1):
+            raise ValueError("invalid GGUF alignment")
+        data_start = (stream.tell() + alignment - 1) // alignment * alignment
+    required = {"general.architecture": "qwen4exp", "qwen4exp.block_count": layers,
+                "qwen4exp.expert_count": experts, "qwen4exp.embedding_length": hidden,
+                "qwen4exp.expert_feed_forward_length": intermediate}
+    for key, expected in required.items():
+        if metadata.get(key) != expected:
+            raise ValueError(f"Q2_0 geometry mismatch: {key}={metadata.get(key)!r}, expected {expected!r}")
+    selected, spans = {}, []
+    source_size = path.stat().st_size
+    for layer in range(layers):
+        for role in ("gate", "up", "down"):
+            name = f"blk.{layer}.ffn_{role}_exps.weight"
+            expected = (intermediate, hidden, experts) if role == "down" else (hidden, intermediate, experts)
+            shape, kind, offset = directory.get(name, (None, None, None))
+            if shape != expected or kind != 42:
+                raise ValueError(f"missing or incompatible Q2_0 expert tensor {name}: {shape}, type {kind}")
+            size = math.prod(shape) // 64 * 18
+            start = data_start + offset
+            if start < data_start or start + size > source_size or offset % alignment:
+                raise ValueError(f"out-of-bounds or misaligned expert tensor {name}")
+            selected[layer, role] = (start, size)
+            spans.append((start, start + size))
+    spans.sort()
+    if any(a[1] > b[0] for a, b in zip(spans, spans[1:])):
+        raise ValueError("overlapping GGUF expert tensors")
+    actual = {name for name in directory if re.fullmatch(r"blk\.\d+\.ffn_(gate|up|down)_exps\.weight", name)}
+    if len(actual) != layers * 3:
+        raise ValueError("unexpected routed-expert tensor count")
+    return selected
+
+
+def iter_q2_expert_pieces(model_path, config, *, chunk=8 << 20):
+    source = config.expert_source
+    if not isinstance(source, dict) or source.get("format") != "q2_0":
+        raise ValueError("Q2_0 requires an explicit expert source")
+    path = Path(source["path"])
+    if not path.is_absolute():
+        path = Path(model_path) / path
+    stat = path.stat()
+    if (source.get("sha256") != SOURCE_SHA256 or stat.st_size != SOURCE_SIZE
+            or source.get("verified_mtime_ns") != stat.st_mtime_ns):
+        raise ValueError("Q2_0 source identity changed; reverify the complete artifact")
+    directory = read_q2_directory(path, layers=config.num_layers, experts=config.num_experts,
+                                  hidden=config.hidden_size, intermediate=config.moe_intermediate_size)
+    E, H, I = config.num_experts, config.hidden_size, config.moe_intermediate_size
+    per_expert = 3 * H * I // 64 * 18
+    count = max(1, min(E, chunk // per_expert))
+    # 有界缓冲区读取原生量化字节，所有 48x512 专家完整加载，禁止缺失专家别名。
+    with path.open("rb", buffering=0) as stream:
+        for layer in range(config.num_layers):
+            for e0 in range(0, E, count):
+                e1 = min(E, e0 + count)
+                pieces = {}
+                for role in ("gate", "up", "down"):
+                    rows, width = (H, I // 64 * 18) if role == "down" else (I, H // 64 * 18)
+                    piece = torch.empty((e1 - e0, rows, width), dtype=torch.uint8)
+                    dst = memoryview(piece.numpy()).cast("B")
+                    start, total = directory[layer, role]
+                    stream.seek(start + e0 * (total // E))
+                    done = 0
+                    while done < len(dst):
+                        got = stream.readinto(dst[done:])
+                        if not got:
+                            raise ValueError("short Q2_0 expert read")
+                        done += got
+                    pieces[role] = piece
+                yield layer, e0, e1, pieces
diff --git a/python/freetoken/moe/fused_q2_0.py b/python/freetoken/moe/fused_q2_0.py
new file mode 100644
--- /dev/null
+++ b/python/freetoken/moe/fused_q2_0.py
@@ -0,0 +1,85 @@
+"""Q2_0 weight-only MoE: native blocks, BF16 activations, FP32 accumulation."""
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _q2_values(W, base, row, k, N: tl.constexpr, K: tl.constexpr):
+    # 每个 64 元素块保存 FP16 scale + 16 字节相邻 2-bit 编码，区别于 Q2_K/TQ2_0。
+    block = base + row[:, None] * (K // 64 * 18) + (k[None, :] // 64) * 18
+    mask = (row[:, None] < N) & (k[None, :] < K)
+    low = tl.load(W + block, mask, 0).to(tl.uint16)
+    high = tl.load(W + block + 1, mask, 0).to(tl.uint16)
+    scale = (low | (high << 8)).to(tl.float16, bitcast=True).to(tl.float32)
+    packed = tl.load(W + block + 2 + k[None, :] % 64 // 4, mask, 0).to(tl.int32)
+    code = (packed >> ((k[None, :] % 4) * 2)) & 3
+    # 权重先舍入到 BF16，主干激活不再额外量化；乘加使用 FP32。
+    return ((code - 1).to(tl.float32) * scale).to(tl.bfloat16).to(tl.float32)
+
+
+@triton.jit
+def _gate_up(X, W, IDS, A, H: tl.constexpr, I: tl.constexpr, TOPK: tl.constexpr,
+             BK: tl.constexpr, BN: tl.constexpr):
+    route = tl.program_id(0)
+    token = route // TOPK
+    expert = tl.load(IDS + route).to(tl.int64)
+    row = tl.program_id(1) * BN + tl.arange(0, BN)
+    k = tl.arange(0, BK)
+    base = expert * (2 * I * (H // 64 * 18))
+    xv = tl.load(X + token * H + k, k < H, 0).to(tl.float32)
+    gate = tl.sum(_q2_values(W, base, row, k, 2 * I, H) * xv[None, :], 1).to(tl.bfloat16).to(tl.float32)
+    up = tl.sum(_q2_values(W, base, row + I, k, 2 * I, H) * xv[None, :], 1).to(tl.bfloat16).to(tl.float32)
+    value = gate / (1.0 + tl.exp(-gate)) * up
+    tl.store(A + route * I + row, value, row < I)
+
+
+@triton.jit
+def _down(A, W, IDS, R, H: tl.constexpr, I: tl.constexpr, BK: tl.constexpr, BN: tl.constexpr):
+    route = tl.program_id(0)
+    expert = tl.load(IDS + route).to(tl.int64)
+    row = tl.program_id(1) * BN + tl.arange(0, BN)
+    k = tl.arange(0, BK)
+    base = expert * (H * (I // 64 * 18))
+    av = tl.load(A + route * I + k, k < I, 0).to(tl.float32)
+    value = tl.sum(_q2_values(W, base, row, k, H, I) * av[None, :], 1)
+    tl.store(R + route * H + row, value, row < H)
+
+
+@triton.jit
+def _reduce(R, WEIGHTS, Y, H: tl.constexpr, TOPK: tl.constexpr, BT: tl.constexpr, BH: tl.constexpr):
+    token = tl.program_id(0)
+    row = tl.program_id(1) * BH + tl.arange(0, BH)
+    route = tl.arange(0, BT)
+    w = tl.load(WEIGHTS + token * TOPK + route, route < TOPK, 0).to(tl.float32)
+    values = tl.load(R + (token * TOPK + route[:, None]) * H + row[None, :],
+                     (route[:, None] < TOPK) & (row[None, :] < H), 0).to(tl.float32)
+    tl.store(Y + token * H + row, tl.sum(values * w[:, None], 0), row < H)
+
+
+def fused_experts_q2_0(x, gate_up, down, topk_weights, topk_ids):
+    if x.dtype != torch.bfloat16 or gate_up.dtype != torch.uint8 or down.dtype != torch.uint8:
+        raise ValueError("Q2_0 requires BF16 activations and native uint8 blocks")
+    if not all(t.is_contiguous() and t.is_cuda for t in (x, gate_up, down, topk_weights, topk_ids)):
+        raise ValueError("Q2_0 tensors must be contiguous CUDA tensors")
+    tokens, hidden = x.shape
+    intermediate = gate_up.shape[1] // 2
+    topk = topk_ids.shape[1]
+    if (hidden % 64 or intermediate % 64 or gate_up.shape[2] != hidden // 64 * 18
+            or down.shape != (gate_up.shape[0], hidden, intermediate // 64 * 18)
+            or topk_ids.shape[0] != tokens or topk_weights.shape != topk_ids.shape):
+        raise ValueError("incompatible Q2_0 expert geometry or routing tensors")
+    active = torch.empty((tokens * topk, intermediate), dtype=x.dtype, device=x.device)
+    routed = torch.empty((tokens * topk, hidden), dtype=x.dtype, device=x.device)
+    out = torch.empty_like(x)
+    _gate_up[(tokens * topk, triton.cdiv(intermediate, 4))](
+        x, gate_up, topk_ids, active, hidden, intermediate, topk,
+        triton.next_power_of_2(hidden), 4, num_warps=8)
+    _down[(tokens * topk, triton.cdiv(hidden, 4))](
+        active, down, topk_ids, routed, hidden, intermediate,
+        triton.next_power_of_2(intermediate), 4, num_warps=4)
+    _reduce[(tokens, triton.cdiv(hidden, 128))](
+        routed, topk_weights, out, hidden, topk, triton.next_power_of_2(topk), 128, num_warps=4)
+    return out
