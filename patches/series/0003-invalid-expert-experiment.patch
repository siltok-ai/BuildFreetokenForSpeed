@@ -0,0 +1,16 @@
+"""无效模型实验：仅用于验证资源与执行流程，生成内容不代表原模型。"""
+
+import os
+
+
+def retained_expert_layers(num_layers: int) -> int:
+    """显式双开关启用专家层别名；默认始终加载完整模型。"""
+    raw = os.environ.get("FREETOKEN_INVALID_EXPERT_KEEP_LAYERS")
+    if raw is None:
+        return num_layers
+    if os.environ.get("FREETOKEN_ALLOW_INVALID_MODEL") != "1":
+        raise RuntimeError("expert alias experiment requires FREETOKEN_ALLOW_INVALID_MODEL=1; outputs are invalid")
+    count = int(raw)
+    if not 1 <= count <= num_layers:
+        raise ValueError("invalid retained expert layer count")
+    return count
diff --git a/tests/moe/test_experimental_alias.py b/tests/moe/test_experimental_alias.py
new file mode 100644
--- /dev/null
+++ b/tests/moe/test_experimental_alias.py
@@ -0,0 +1,135 @@
+"""Exercise real NVFP4 packing and pinned banks for the invalid-model capacity experiment."""
+
+import pytest
+import torch
+
+from freetoken.layers.quantization.moe.base import MoEConfig
+from freetoken.layers.quantization.moe.nvfp4 import Nvfp4MoEMethod
+from freetoken.layers.quantization.scheme import nvfp4_scheme
+from freetoken.moe.expert_banks import build_expert_banks
+from freetoken.moe.experimental_alias import retained_expert_layers
+
+
+def test_alias_requires_explicit_invalid_model_switch(monkeypatch):
+    monkeypatch.setenv("FREETOKEN_INVALID_EXPERT_KEEP_LAYERS", "2")
+    monkeypatch.delenv("FREETOKEN_ALLOW_INVALID_MODEL", raising=False)
+    with pytest.raises(RuntimeError, match="outputs are invalid"):
+        retained_expert_layers(3)
+
+
+def _aliased_banks(monkeypatch):
+    monkeypatch.setenv("FREETOKEN_ALLOW_INVALID_MODEL", "1")
+    monkeypatch.setenv("FREETOKEN_INVALID_EXPERT_KEEP_LAYERS", "2")
+    cfg = MoEConfig(4, 64, 32, 2, scheme=nvfp4_scheme(input_scale=False), strategy="offload")
+    method = Nvfp4MoEMethod(cfg, "triton")
+    pieces = []
+    for layer in range(2):
+        values = {}
+        for proj, rows, cols in (("gate", 32, 64), ("up", 32, 64), ("down", 64, 32)):
+            values[proj] = torch.full((4, rows, cols // 2), 17 + layer, dtype=torch.uint8)
+            values[proj + "_scale"] = torch.full((4, rows, cols // 16), 1 + layer, dtype=torch.float8_e4m3fn)
+            values[proj + "_global"] = torch.full((4,), 0.25 + layer, dtype=torch.float16)
+        pieces.append((layer, 0, 4, values))
+    return build_expert_banks(method, 3, iter(pieces), device=torch.device("cuda"))
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="real pinned banks need CUDA")
+def test_alias_packs_only_retained_layers_and_preserves_scale_bytes(monkeypatch):
+    banks = _aliased_banks(monkeypatch)
+    for role, per_layer in banks.sources.items():
+        assert per_layer[2].data_ptr() == per_layer[0].data_ptr(), role
+        assert per_layer[1].data_ptr() != per_layer[0].data_ptr(), role
+        assert torch.equal(per_layer[2].view(torch.uint8), per_layer[0].view(torch.uint8)), role
+        assert per_layer[0].is_pinned(), role
+    unique_bytes = sum(t.nbytes for layers in banks.sources.values() for t in layers[:2])
+    logical_bytes = sum(t.nbytes for layers in banks.sources.values() for t in layers)
+    assert unique_bytes * 3 == logical_bytes * 2
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="actual offload, GEMM and graphs need CUDA")
+def test_alias_survives_offload_prefill_eviction_decode_and_graph(monkeypatch):
+    from freetoken.moe.offload_cache import OffloadMoeCache
+    from freetoken.moe.fused_nvfp4 import fused_experts_decode_nvfp4_marlin, fused_experts_nvfp4
+
+    banks = _aliased_banks(monkeypatch)
+    cache = OffloadMoeCache(num_layers=3, num_experts=4, cache_size=4,
+                           device=torch.device("cuda"), quant_format=banks.quant_format,
+                           layout=banks.layout)
+    cache.set_bank_sources(banks.sources)
+    cache.reset()
+    x = torch.full((1, 64), 0.01, dtype=torch.bfloat16, device="cuda")
+    weights = torch.tensor([[0.7, 0.3]], dtype=torch.float32, device="cuda")
+    raw_ids = torch.tensor([[1, 3]], dtype=torch.int32, device="cuda")
+
+    def decode(layer):
+        ids = raw_ids.clone()
+        cache.ensure_experts(layer, ids)
+        cache.copy_missing()
+        out = fused_experts_decode_nvfp4_marlin(x, *cache.bank_views(), weights, ids)
+        return out, ids
+
+    out0, ids0 = decode(0)
+    out2, ids2 = decode(2)
+    torch.cuda.synchronize()
+    assert set(ids0.flatten().tolist()).isdisjoint(ids2.flatten().tolist())
+    torch.testing.assert_close(out0, out2)
+    assert torch.isfinite(out2).all() and torch.count_nonzero(out2) > 0
+
+    # A prefill of a distinct physical layer evicts both logical aliases.
+    cache.materialize_layer(1)
+    cache.copy_missing()
+    for name in cache.bank_schema:
+        assert torch.equal(cache.bank_caches[name].cpu().view(torch.uint8),
+                           cache.bank_sources[name][1].view(torch.uint8))
+    prefill_ids = torch.tensor([[1, 3]], dtype=torch.int32, device="cuda")
+    prefill = fused_experts_nvfp4(x, *cache.bank_views(), weights, prefill_ids, 4)
+    assert torch.isfinite(prefill).all()
+    assert cache.slot_for_id[0].eq(-1).all() and cache.slot_for_id[2].eq(-1).all()
+    out_after_eviction, _ = decode(2)
+    torch.testing.assert_close(out_after_eviction, out0)
+
+    # Replay must run actual cache movement and GEMV with stable host addresses.
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for _ in range(3):
+            decode(0)
+            decode(1)
+            decode(2)
+    torch.cuda.current_stream().wait_stream(stream)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        decode(0)
+        decode(1)
+        graph_out, _ = decode(2)
+    for _ in range(3):
+        graph.replay()
+    torch.cuda.synchronize()
+    torch.testing.assert_close(graph_out, out0)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="actual asynchronous H2D and GEMM need CUDA")
+def test_alias_works_with_prefill_double_buffer_overlap(monkeypatch):
+    from freetoken.moe.offload_cache import OffloadMoeCache
+    from freetoken.moe.fused_nvfp4 import fused_experts_nvfp4
+
+    banks = _aliased_banks(monkeypatch)
+    cache = OffloadMoeCache(3, 4, 8, torch.device("cuda"), prefill_overlap=True,
+                           quant_format=banks.quant_format, layout=banks.layout)
+    cache.set_bank_sources(banks.sources)
+    cache.reset()
+    x = torch.full((1, 64), 0.01, dtype=torch.bfloat16, device="cuda")
+    weights = torch.tensor([[0.7, 0.3]], dtype=torch.float32, device="cuda")
+    ids = torch.tensor([[1, 3]], dtype=torch.int32, device="cuda")
+    outputs = []
+    cache.begin_prefill()
+    cache.prefetch_prefill_layer(0)
+    for layer in range(3):
+        cache.prefetch_prefill_layer(layer + 1)
+        views = cache.wait_prefill_layer(layer)
+        outputs.append(fused_experts_nvfp4(x, *views, weights, ids, 4))
+        cache.release_prefill_layer(layer)
+    torch.cuda.synchronize()
+    assert all(torch.isfinite(output).all().item() for output in outputs)
+    torch.testing.assert_close(outputs[0], outputs[2])
+    assert not torch.allclose(outputs[0], outputs[1])
