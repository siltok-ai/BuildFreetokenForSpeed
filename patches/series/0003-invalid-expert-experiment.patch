+"""等待下载的真实分片完整，核对大小和布局后自动执行无效专家模型的 smoke/benchmark。"""
+
+import argparse
+from datetime import datetime
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import time
+
+
+def main():
+    """下载和推理依次执行；任何校验或推理失败保留日志并停止，不伪造成功结果。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--metadata", type=Path, required=True)
+    parser.add_argument("--cache", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--timeout-hours", type=float, default=6)
+    args = parser.parse_args()
+    source = json.loads((args.metadata / "research-source.json").read_text(encoding="utf-8"))
+    sizes = {entry["Path"]: entry["Size"] for entry in source["files"]}
+    marker = json.loads((args.model / "INVALID-EXPERT-ALIASES.json").read_text(encoding="utf-8"))
+    selected = marker["selected_shards"]
+    root = Path(__file__).resolve().parents[1]
+    args.output.mkdir(parents=True, exist_ok=True)
+    status = {"status": "waiting_for_download", "started": datetime.now().astimezone().isoformat(),
+              "model": str(args.model), "INVALID_MODEL": True, "total_files": len(selected)}
+
+    def save():
+        status["updated"] = datetime.now().astimezone().isoformat()
+        path = args.output / "automatic-validation-status.json"
+        temporary = path.with_suffix(".tmp")
+        temporary.write_text(json.dumps(status, indent=2) + "\n", encoding="utf-8")
+        temporary.replace(path)
+
+    began = time.monotonic()
+    try:
+        while True:
+            complete = [name for name in selected if (args.model / name).is_file()
+                        and (args.model / name).stat().st_size == sizes[name]]
+            status["complete_files"] = len(complete)
+            status["complete_bytes"] = sum(sizes[name] for name in complete)
+            try:
+                current = json.loads((args.model / "INVALID-EXPERT-ALIASES.json").read_text(encoding="utf-8"))
+                downloaded = {entry["name"] for entry in current["completed"]}
+                verified = {entry["name"] for entry in current["completed"] if len(entry.get("sha256", "")) == 64}
+            except json.JSONDecodeError:
+                # 下载器旧进程原地写清单时，下一轮重新读取；不提前进入生成。
+                verified = set()
+                downloaded = set()
+            status["sdk_download_completed_files"] = len(downloaded.intersection(selected))
+            status["sha256_verified_files"] = len(verified.intersection(selected))
+            save()
+            if len(complete) == len(selected) and set(selected) <= verified:
+                break
+            if time.monotonic() - began > args.timeout_hours * 3600:
+                raise TimeoutError("weights are not ready before the automatic validation deadline")
+            time.sleep(20)
+        status["status"] = "validating_checkpoint_layout"
+        save()
+        index = (args.model / "model.safetensors.index.json").read_bytes()
+        if hashlib.sha256(index).hexdigest() != marker["index_sha256"]:
+            raise ValueError("checkpoint index changed since the experiment download plan")
+        # master 非不可变 revision：核对实际张量布局与研究阶段读取的远端 header。
+        for name in selected:
+            expected = json.loads((args.metadata / "research-headers" / (name + ".json")).read_text(encoding="utf-8"))
+            with (args.model / name).open("rb") as file:
+                header_size = struct.unpack("<Q", file.read(8))[0]
+                actual = json.loads(file.read(header_size))
+            if actual != expected:
+                raise ValueError(f"checkpoint tensor layout changed: {name}")
+        status["validated_shards"] = len(selected)
+        common = [sys.executable, str(root / "tools" / "benchmark_alias40.py"),
+                  "--model", str(args.model), "--cache", str(args.cache)]
+        for stage, extra in (("smoke", ["--prompt-tokens", "128", "--output-tokens", "32", "--repeats", "1", "--collect-cache-stats"]),
+                             ("benchmark", ["--prompt-tokens", "128", "1024", "--output-tokens", "128", "--repeats", "2"])):
+            status["status"] = "running_" + stage
+            save()
+            with (args.output / ("alias40-" + stage + ".log")).open("w", encoding="utf-8") as log:
+                result = subprocess.run(common + ["--report", str(args.output / ("alias40-" + stage + ".json"))] + extra,
+                                        cwd=root, stdout=log, stderr=subprocess.STDOUT)
+            status[stage + "_exit_code"] = result.returncode
+            if result.returncode:
+                raise RuntimeError(f"{stage} exited with {result.returncode}; inspect alias40-{stage}.log")
+        status["status"] = "complete"
+    except BaseException as exc:
+        status["status"] = "failed"
+        status["error"] = {"type": type(exc).__name__, "message": str(exc)}
+        raise
+    finally:
+        save()
+
+
+if __name__ == "__main__":
+    main()
