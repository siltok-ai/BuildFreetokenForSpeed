+++ b/tools/probe_alias_checkpoint.py
@@ -0,0 +1,90 @@
+"""使用已下载的真实第一层 checkpoint 验证 NVFP4 reader 会跳过其余未下载专家层。"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+
+def main():
+    """从原始完整索引加载真实专家并打包；不改写索引、不伪造 reader 返回值。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument("--keep-layers", type=int, default=1)
+    args = parser.parse_args()
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "python"))
+    os.environ["FREETOKEN_ALLOW_INVALID_MODEL"] = "1"
+    os.environ["FREETOKEN_INVALID_EXPERT_KEEP_LAYERS"] = str(args.keep_layers)
+    import psutil
+    import safetensors
+    import torch
+    from freetoken.layers.quantization import QuantKind
+    from freetoken.layers.quantization.moe.base import MoEConfig
+    from freetoken.layers.quantization.moe.nvfp4 import Nvfp4MoEMethod
+    from freetoken.layers.quantization.scheme import nvfp4_scheme
+    from freetoken.moe.expert_banks import build_expert_banks
+    from freetoken.moe.expert_pieces import iter_expert_pieces
+
+    config = SimpleNamespace(architectures=["Qwen4ExpForConditionalGeneration"],
+                             model_type="qwen4_exp", num_layers=48,
+                             num_moe_layers=48, num_experts=512)
+    method = Nvfp4MoEMethod(MoEConfig(512, 2560, 640, 10,
+                                    scheme=nvfp4_scheme(input_scale=False), strategy="offload"), "triton")
+    original_open = safetensors.safe_open
+    opened = []
+    torch.cuda.init()
+    process = psutil.Process()
+    baseline_rss = process.memory_info().rss
+    memory = {"rss_peak_bytes": baseline_rss,
+              "host_available_min_bytes": psutil.virtual_memory().available}
+    stop = threading.Event()
+
+    def monitor():
+        while not stop.is_set():
+            memory["rss_peak_bytes"] = max(memory["rss_peak_bytes"], process.memory_info().rss)
+            memory["host_available_min_bytes"] = min(memory["host_available_min_bytes"], psutil.virtual_memory().available)
+            stop.wait(0.1)
+
+    thread = threading.Thread(target=monitor, daemon=True)
+    thread.start()
+    began = time.perf_counter()
+
+    def observed_open(path, *pos, **kwargs):
+        opened.append(Path(path).name)
+        return original_open(path, *pos, **kwargs)
+
+    safetensors.safe_open = observed_open
+    try:
+        pieces = iter_expert_pieces(str(args.model), config, QuantKind.NVFP4, parallel=False)
+        banks = build_expert_banks(method, 48, pieces, device=torch.device("cuda"))
+    finally:
+        safetensors.safe_open = original_open
+        stop.set()
+        thread.join()
+    expected = {f"layer-{layer:05d}-experts-{first:04d}-{first + 127:04d}.safetensors"
+                for layer in range(args.keep_layers) for first in (0, 128, 256, 384)}
+    assert set(opened) == expected
+    for per_layer in banks.sources.values():
+        assert len({t.data_ptr() for t in per_layer}) == args.keep_layers
+        assert per_layer[47].is_pinned()
+    unique = {t.data_ptr(): t for tensors in banks.sources.values() for t in tensors}
+    memory["rss_after_bytes"] = process.memory_info().rss
+    memory["rss_peak_bytes"] = max(memory["rss_peak_bytes"], memory["rss_after_bytes"])
+    result = {"payload": "real ModelScope checkpoint retained experts", "logical_layers": 48,
+              "physical_layers": args.keep_layers, "opened_shards": sorted(set(opened)),
+              "elapsed_seconds": time.perf_counter() - began,
+              "baseline_rss_bytes": baseline_rss, "memory": memory,
+              "unique_bank_bytes": sum(t.nbytes for t in unique.values()),
+              "all_unique_banks_pinned": all(t.is_pinned() for t in unique.values())}
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/probe_alias_memory.py b/tools/probe_alias_memory.py
new file mode 100644
--- /dev/null
+++ b/tools/probe_alias_memory.py
@@ -0,0 +1,161 @@
+"""用真实 NVFP4 bank 分配、packing、pin 和 offload 验证物理内存；填充数据仅供容量测试。"""
+
+import argparse
+import gc
+import json
+import math
+import os
+from pathlib import Path
+import sys
+import threading
+import time
+
+
+def main():
+    """每次独立进程运行，避免上游终身保留 mmap 使 A/B 的内存结果相互污染。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--keep-layers", type=int, required=True)
+    parser.add_argument("--experts", type=int, default=16)
+    parser.add_argument("--cache", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument("--exercise-cache", action="store_true")
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    sys.path.insert(0, str(root / "python"))
+    if args.keep_layers != 48:
+        os.environ["FREETOKEN_ALLOW_INVALID_MODEL"] = "1"
+        os.environ["FREETOKEN_INVALID_EXPERT_KEEP_LAYERS"] = str(args.keep_layers)
+    else:
+        os.environ.pop("FREETOKEN_INVALID_EXPERT_KEEP_LAYERS", None)
+    os.environ["FREETOKEN_KERNEL_CACHE_DIR"] = str(args.cache.resolve())
+    os.environ["FREETOKEN_DISABLE_JIT"] = "1"
+    import psutil
+    import torch
+    from freetoken.layers.quantization.moe.base import MoEConfig
+    from freetoken.layers.quantization.moe.nvfp4 import Nvfp4MoEMethod
+    from freetoken.layers.quantization.scheme import nvfp4_scheme
+    from freetoken.moe.expert_banks import build_expert_banks
+    from freetoken.moe.host_banks import HostBank
+
+    torch.set_num_threads(4)
+    torch.cuda.init()
+    warm = HostBank((4096,), torch.uint8)
+    warm.tensor.fill_(1)
+    warm.pin()
+    torch.cuda.synchronize()
+    cfg = MoEConfig(args.experts, 2560, 640, min(10, args.experts),
+                    scheme=nvfp4_scheme(input_scale=False), strategy="offload")
+    method = Nvfp4MoEMethod(cfg, "triton")
+    per_layer = sum(torch.empty((), dtype=s.dtype).element_size() *
+                    math.prod(s.shape) * args.experts
+                    for s in method.layout().values() if not s.resident)
+    needed = per_layer * args.keep_layers
+    if needed + 4 * 2**30 > psutil.virtual_memory().available:
+        raise RuntimeError("capacity probe cannot leave 4 GiB host headroom")
+    process = psutil.Process()
+
+    def sample():
+        info = process.memory_info()
+        return {"rss_bytes": info.rss, "private_bytes": getattr(info, "private", info.vms),
+                "system_available_bytes": psutil.virtual_memory().available,
+                "gpu_allocated_bytes": torch.cuda.memory_allocated()}
+
+    gc.collect()
+    baseline = sample()
+    peaks = baseline.copy()
+    report = {"kind": "synthetic payload; real allocation/packing/pin/offload",
+              "logical_layers": 48, "physical_layers": args.keep_layers,
+              "experts_per_layer": args.experts, "hidden": 2560, "intermediate": 640,
+              "expected_physical_bank_bytes": needed, "baseline": baseline,
+              "status": "packing", "peaks": peaks}
+
+    def save():
+        args.report.parent.mkdir(parents=True, exist_ok=True)
+        args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+
+    stop = threading.Event()
+
+    def monitor():
+        while not stop.is_set():
+            current = sample()
+            for key, value in current.items():
+                peaks[key] = min(peaks[key], value) if key == "system_available_bytes" else max(peaks[key], value)
+            stop.wait(0.05)
+
+    def pieces():
+        # 每次最多打包 8 个专家，避免 torch.cat 为整层临时物化数百 MiB。
+        for layer in range(args.keep_layers):
+            values = {}
+            for proj, rows, cols in (("gate", 640, 2560), ("up", 640, 2560), ("down", 2560, 640)):
+                values[proj] = torch.full((1, rows, cols // 2), 17 + layer % 7, dtype=torch.uint8)
+                values[proj + "_scale"] = torch.ones((1, rows, cols // 16), dtype=torch.float8_e4m3fn)
+                values[proj + "_global"] = torch.full((1,), 0.001, dtype=torch.float16)
+            for first in range(0, args.experts, 8):
+                last = min(first + 8, args.experts)
+                yield layer, first, last, {name: t.expand(last - first, *t.shape[1:]) for name, t in values.items()}
+            print(f"filled physical layer {layer + 1}/{args.keep_layers}", flush=True)
+
+    save()
+    thread = threading.Thread(target=monitor, daemon=True)
+    thread.start()
+    started = time.perf_counter()
+    try:
+        banks = build_expert_banks(method, 48, pieces(), device=torch.device("cuda"))
+        gc.collect()
+        report["packing_seconds"] = time.perf_counter() - started
+        report["after_banks"] = sample()
+        unique = {t.data_ptr(): t for tensors in banks.sources.values() for t in tensors}
+        report["unique_bank_bytes"] = sum(t.nbytes for t in unique.values())
+        report["logical_bank_bytes"] = sum(t.nbytes for tensors in banks.sources.values() for t in tensors)
+        report["unique_bank_count"] = len(unique)
+        report["all_unique_banks_pinned"] = all(t.is_pinned() for t in unique.values())
+        assert report["unique_bank_bytes"] == needed
+        assert report["all_unique_banks_pinned"]
+        for per_role in banks.sources.values():
+            for layer in range(48):
+                assert per_role[layer].data_ptr() == per_role[layer % args.keep_layers].data_ptr()
+        save()
+        if args.exercise_cache:
+            from freetoken.moe.offload_cache import OffloadMoeCache
+            from freetoken.moe.fused_nvfp4 import fused_experts_decode_nvfp4_marlin
+
+            cache = OffloadMoeCache(48, args.experts, max(512, args.experts),
+                                   torch.device("cuda"), quant_format=banks.quant_format,
+                                   layout=banks.layout)
+            cache.set_bank_sources(banks.sources)
+            cache.reset()
+            x = torch.full((1, 2560), 0.01, dtype=torch.bfloat16, device="cuda")
+            weights = torch.full((1, cfg.top_k), 1.0 / cfg.top_k, device="cuda")
+            raw_ids = torch.arange(cfg.top_k, dtype=torch.int32, device="cuda")[None, :]
+            outputs = []
+            for layer in range(48):
+                if layer in {0, args.keep_layers - 1, args.keep_layers, 47}:
+                    cache.materialize_layer(layer)
+                    cache.copy_missing()
+                ids = raw_ids.clone()
+                cache.ensure_experts(layer, ids)
+                cache.copy_missing()
+                outputs.append(fused_experts_decode_nvfp4_marlin(x, *cache.bank_views(), weights, ids))
+            torch.cuda.synchronize()
+            assert all(torch.isfinite(o).all().item() for o in outputs)
+            for layer in range(args.keep_layers, 48):
+                torch.testing.assert_close(outputs[layer], outputs[layer % args.keep_layers])
+            report["offload_decode_layers_executed"] = 48
+            report["after_offload"] = sample()
+        report["status"] = "complete"
+    except BaseException as exc:
+        report["status"] = "failed"
+        report["error"] = {"type": type(exc).__name__, "message": str(exc)}
+        raise
+    finally:
+        stop.set()
+        thread.join()
+        current = sample()
+        for key, value in current.items():
+            peaks[key] = min(peaks[key], value) if key == "system_available_bytes" else max(peaks[key], value)
+        save()
+    print(json.dumps(report, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/probe_flash_next_aot.py b/tools/probe_flash_next_aot.py
