+++ b/tools/prepare_range_resume.py
@@ -0,0 +1,55 @@
+"""停止本任务下载后，将已有连续前缀复制为 ModelScope SDK 的分段续传缓存，保留原前缀。"""
+
+import argparse
+import json
+from pathlib import Path
+
+
+def main():
+    """严格按 SDK 的分段边界复制已下载字节，不重下前缀、不删除原续传文件。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--metadata", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    from modelscope_hub.constants import DOWNLOAD_PART_SIZE
+    source = json.loads((args.metadata / "research-source.json").read_text(encoding="utf-8"))
+    sizes = {entry["Path"]: entry["Size"] for entry in source["files"]}
+    plan = json.loads((args.model / "INVALID-EXPERT-ALIASES.json").read_text(encoding="utf-8"))
+    seeded = []
+    for name in plan["selected_shards"]:
+        target = args.model / name
+        prefix = target.with_suffix(target.suffix + ".incomplete")
+        if target.exists() or not prefix.exists():
+            continue
+        with prefix.open("rb") as file:
+            prefix_size = file.seek(0, 2)
+            if prefix_size > sizes[name]:
+                raise ValueError(f"downloaded prefix exceeds expected file size: {name}")
+            file.seek(0)
+            for start in range(0, prefix_size, DOWNLOAD_PART_SIZE):
+                end = min(start + DOWNLOAD_PART_SIZE, sizes[name]) - 1
+                length = min(end - start + 1, prefix_size - start)
+                part = Path(str(target) + f"_{start}_{end}")
+                if part.exists():
+                    raise FileExistsError(f"unexpected existing parallel part: {part.name}")
+                with part.open("wb") as output:
+                    remaining = length
+                    while remaining:
+                        chunk = file.read(min(4 * 2**20, remaining))
+                        if not chunk:
+                            raise OSError(f"short source prefix: {name}")
+                        output.write(chunk)
+                        remaining -= len(chunk)
+                assert part.stat().st_size == length
+        seeded.append({"name": name, "prefix_bytes_preserved": prefix_size})
+    result = {"part_bytes": DOWNLOAD_PART_SIZE, "seeded": seeded,
+              "total_preserved_bytes": sum(item["prefix_bytes_preserved"] for item in seeded),
+              "original_incomplete_files_retained": True}
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/probe_alias_checkpoint.py b/tools/probe_alias_checkpoint.py
new file mode 100644
