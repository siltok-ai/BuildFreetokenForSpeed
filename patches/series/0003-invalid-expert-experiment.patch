@@ -0,0 +1,202 @@
+"""直接运行 FreeToken 的无效专家别名模型，验证 SSD PLE 并记录真实执行性能。"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import threading
+import time
+
+
+def write_report(path, report):
+    """保存已完成阶段，即使后续初始化或生成失败仍保留诊断与内存峰值。"""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+def main():
+    """显式启用无效模型实验，保留真实权重、层数、路由与 SSD 查表。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--cache", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument("--cache-slots", type=int, default=1024)
+    parser.add_argument("--kv-tokens", type=int, default=8192)
+    parser.add_argument("--prefill-tokens", type=int, default=1024)
+    parser.add_argument("--output-tokens", type=int, default=128)
+    parser.add_argument("--repeats", type=int, default=2)
+    parser.add_argument("--prompt-tokens", type=int, nargs="+", default=[128, 1024])
+    parser.add_argument("--no-cuda-graph", action="store_true")
+    parser.add_argument("--collect-cache-stats", action="store_true")
+    args = parser.parse_args()
+    marker = json.loads((args.model / "INVALID-EXPERT-ALIASES.json").read_text(encoding="utf-8"))
+    if marker["INVALID_MODEL"] is not True or marker["logical_layers"] != 48:
+        raise ValueError("model directory lacks the explicit invalid-model experiment marker")
+    missing = [name for name in marker["selected_shards"] if not (args.model / name).is_file()]
+    if missing:
+        raise RuntimeError(f"experiment still needs {len(missing)} complete weight shards")
+    source = Path(__file__).resolve().parents[1]
+    sys.path.insert(0, str(source / "python"))
+    os.environ["FREETOKEN_ALLOW_INVALID_MODEL"] = "1"
+    os.environ["FREETOKEN_INVALID_EXPERT_KEEP_LAYERS"] = str(marker["keep_layers"])
+    os.environ["FREETOKEN_KERNEL_CACHE_DIR"] = str(args.cache.resolve())
+    os.environ["FREETOKEN_DISABLE_JIT"] = "1"
+    import psutil
+    import torch
+    from freetoken.core import SamplingParams
+    from freetoken.kernel import backend
+    from freetoken.llm import LLM
+    from freetoken.message import DetokenizeMsg, PromptAdmittedMsg
+    from freetoken.mm.config import ENCODER_KINDS, MultimodalConfig
+
+    backend.is_flashinfer_installed = lambda: False
+    if torch.cuda.is_initialized():
+        raise RuntimeError("FreeToken must own the process's first CUDA initialization")
+    config = json.loads((args.model / "config.json").read_text(encoding="utf-8"))
+    if config["architectures"] != ["Qwen4ExpForConditionalGeneration"]:
+        raise ValueError("experiment expects Qwen4ExpForConditionalGeneration")
+    report = {
+        "INVALID_MODEL": True, "quality_is_meaningless": True,
+        "performance_scope": "aliased experts can change routing and cache hit rate; this is not full-model throughput",
+        "source_commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=source, text=True).strip(),
+        "model": str(args.model.resolve()), "keep_layers": marker["keep_layers"],
+        "parameters": vars(args) | {"model": str(args.model), "cache": str(args.cache), "report": str(args.report)},
+        "torch": torch.__version__, "status": "loading", "runs": [],
+        "memory": {"rss_peak_bytes": 0, "private_peak_bytes": 0,
+                   "gpu_allocated_peak_bytes": 0, "gpu_reserved_peak_bytes": 0,
+                   "gpu_device_used_peak_bytes": 0,
+                   "host_available_min_bytes": psutil.virtual_memory().available},
+    }
+    write_report(args.report, report)
+    process = psutil.Process()
+    stop = threading.Event()
+
+    def monitor():
+        """仅在 Engine 初始化 CUDA 后读取 Torch 计数器，避免监测线程抢占首个 CUDA owner。"""
+        while not stop.is_set():
+            info = process.memory_info()
+            stats = report["memory"]
+            stats["rss_peak_bytes"] = max(stats["rss_peak_bytes"], info.rss)
+            stats["private_peak_bytes"] = max(stats["private_peak_bytes"], getattr(info, "private", info.vms))
+            stats["host_available_min_bytes"] = min(stats["host_available_min_bytes"], psutil.virtual_memory().available)
+            if torch.cuda.is_initialized():
+                stats["gpu_allocated_peak_bytes"] = max(stats["gpu_allocated_peak_bytes"], torch.cuda.max_memory_allocated())
+                stats["gpu_reserved_peak_bytes"] = max(stats["gpu_reserved_peak_bytes"], torch.cuda.max_memory_reserved())
+                free, total = torch.cuda.mem_get_info()
+                stats["gpu_device_used_peak_bytes"] = max(stats["gpu_device_used_peak_bytes"], total - free)
+            stop.wait(0.25)
+
+    class MeasuredLLM(LLM):
+        def offline_send_result(self, reply):
+            """记录真实 token 到达时间，再交由上游原生 offline API 收集结果。"""
+            now = time.perf_counter()
+            for message in reply:
+                if isinstance(message, DetokenizeMsg):
+                    self.token_times.append(now)
+                elif isinstance(message, PromptAdmittedMsg):
+                    self.prompt_admissions.append({"prompt_tokens": message.prompt_tokens,
+                                                   "cached_tokens": message.cached_tokens})
+            return super().offline_send_result(reply)
+
+    thread = threading.Thread(target=monitor, daemon=True)
+    thread.start()
+    llm = None
+    started = time.perf_counter()
+    try:
+        llm = MeasuredLLM(
+            str(args.model.resolve()), dtype=torch.bfloat16, max_running_req=1,
+            attention_backend="qsa_sparse", moe_strategy="offload", ple_backend="disk",
+            mm=MultimodalConfig(disabled_encoders=frozenset(ENCODER_KINDS)),
+            quant_backend="moe.nvfp4=triton", expert_load="serial",
+            moe_cache_size=args.cache_slots, moe_cache_auto=False,
+            moe_collect_stats=args.collect_cache_stats,
+            kv_reserve_tokens=args.kv_tokens, num_token_override=args.kv_tokens,
+            max_extend_tokens=args.prefill_tokens, max_seq_len_override=262144,
+            cuda_graph_max_bs=0 if args.no_cuda_graph else 1,
+            memory_ratio=0.80, cache_type="radix", decode_log_interval=1000,
+        )
+        report["load_seconds"] = time.perf_counter() - started
+        cache = llm.engine.moe_offload_cache
+        banks = cache.bank_sources
+        unique = {tensor.data_ptr(): tensor for per_layer in banks.values() for tensor in per_layer}
+        report["unique_expert_bank_bytes"] = sum(t.nbytes for t in unique.values())
+        report["logical_expert_bank_bytes"] = sum(t.nbytes for tensors in banks.values() for t in tensors)
+        if report["unique_expert_bank_bytes"] * marker["logical_layers"] != report["logical_expert_bank_bytes"] * marker["keep_layers"]:
+            raise RuntimeError("loaded expert banks do not have the intended physical/logical alias ratio")
+        if not all(t.is_pinned() for t in unique.values()):
+            raise RuntimeError("experiment banks must actually be pinned for GPU movement")
+        report["unique_expert_bank_count"] = len(unique)
+        report["host_ple_pinned_bytes"] = llm.engine._host_tables_bytes
+        disk = llm.engine.model._ple_table
+        report["ple_io_backend"] = disk._store.io_backend()
+        report["ple_staging_pinned_bytes"] = disk._graph_pinned.nbytes + sum(t.nbytes for t in disk._eager_pinned)
+        report["ple_sync"] = "wait" if disk._wait_sync else "gate"
+        report["ple_io_after_load"] = disk._store.io_stats()
+        report["resolved_config"] = {
+            "page_size": llm.config.page_size, "cache_type": llm.config.cache_type,
+            "attention_backend": llm.config.attention_backend, "moe_strategy": llm.config.moe_strategy,
+            "ple_backend": llm.config.ple_backend, "active_encoders": len(llm.config.active_encoders),
+            "num_pages": llm.engine.num_pages,
+        }
+        report["status"] = "generating"
+        write_report(args.report, report)
+        base = llm.tokenizer.apply_chat_template(
+            [{"role": "user", "content": "请继续写一段关于计算机的介绍。"}],
+            tokenize=True, return_dict=False, add_generation_prompt=True, enable_thinking=False,
+        )
+        filler = llm.tokenizer.encode("计算机处理信息，程序执行计算。", add_special_tokens=False)
+        for length in args.prompt_tokens:
+            prompt = (base + filler * (length // len(filler) + 1))[:length]
+            for repeat in range(args.repeats):
+                llm.token_times = []
+                llm.prompt_admissions = []
+                before_io = disk._store.io_stats()
+                if args.collect_cache_stats:
+                    cache.reset_stats()
+                began = time.perf_counter()
+                output = llm.generate([prompt], SamplingParams(temperature=0.0, top_k=1,
+                                      ignore_eos=True, max_tokens=args.output_tokens))[0]
+                torch.cuda.synchronize()
+                ended = time.perf_counter()
+                first = llm.token_times[0]
+                count = len(output["token_ids"])
+                run = {
+                    "prompt_tokens": len(prompt), "repeat": repeat, "output_tokens": count,
+                    "prompt_admissions": llm.prompt_admissions,
+                    "cached_prompt_tokens": sum(a["cached_tokens"] for a in llm.prompt_admissions),
+                    "total_seconds": ended - began, "ttft_seconds": first - began,
+                    "decode_tokens_per_second": (count - 1) / (ended - first) if count > 1 else None,
+                    "overall_tokens_per_second": count / (ended - began),
+                    "INVALID_output_preview": output["text"][:200],
+                    "gpu_allocated_bytes": torch.cuda.memory_allocated(),
+                    "gpu_reserved_bytes": torch.cuda.memory_reserved(),
+                    "ple_io": disk._store.io_stats(),
+                }
+                if run["ple_io"]["read_requests_completed"] <= before_io["read_requests_completed"]:
+                    raise RuntimeError("generation made no actual PLE file reads")
+                run["ple_read_requests_this_run"] = run["ple_io"]["read_requests_completed"] - before_io["read_requests_completed"]
+                if args.collect_cache_stats:
+                    run["expert_cache_decode"] = cache.decode_miss_stats()
+                report["runs"].append(run)
+                write_report(args.report, report)
+                print(json.dumps(run, ensure_ascii=False), flush=True)
+        report["status"] = "complete"
+    except BaseException as exc:
+        report["status"] = "failed"
+        report["error"] = {"type": type(exc).__name__, "message": str(exc)}
+        raise
+    finally:
+        stop.set()
+        thread.join(timeout=2)
+        info = process.memory_info()
+        report["memory"]["rss_peak_bytes"] = max(report["memory"]["rss_peak_bytes"],
+                                                getattr(info, "peak_wset", info.rss))
+        write_report(args.report, report)
+        if llm is not None:
+            llm.engine.shutdown()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/download_alias_experiment.py b/tools/download_alias_experiment.py
new file mode 100644
--- /dev/null
+++ b/tools/download_alias_experiment.py
@@ -0,0 +1,88 @@
+"""下载无效专家别名实验需要的真实权重；保留原索引，显式记录省略的专家。"""
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor, as_completed
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import time
+
+
+def main():
+    """仅选保留层专家及真实 dense/PLE 分片，下载可续传并记录每个文件完成情况。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--metadata", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--keep-layers", type=int, default=30)
+    parser.add_argument("--workers", type=int, default=3)
+    parser.add_argument("--range-workers", type=int, default=4)
+    parser.add_argument("--plan-only", action="store_true")
+    args = parser.parse_args()
+    os.environ["MODELSCOPE_DOWNLOAD_PARALLEL_WORKERS"] = str(args.range_workers)
+    from modelscope_hub import HubApi
+    api = HubApi()
+    source = json.loads((args.metadata / "research-source.json").read_text(encoding="utf-8"))
+    index = json.loads((args.metadata / "model.safetensors.index.json").read_text(encoding="utf-8"))
+    selected = set()
+    for name, shard in index["weight_map"].items():
+        expert = re.match(r"model\.language_model\.layers\.(\d+)\.mlp\.experts\.", name)
+        if expert and int(expert[1]) >= args.keep_layers:
+            continue
+        if name.startswith(("mtp.", "model.visual.")):
+            continue
+        selected.add(shard)
+    files = {item["Path"]: item["Size"] for item in source["files"]}
+    args.output.mkdir(parents=True, exist_ok=True)
+    for name in ("config.json", "generation_config.json", "tokenizer.json", "tokenizer_config.json",
+                 "chat_template.jinja", "model.safetensors.index.json", "hf_quant_config.json"):
+        path = args.metadata / name
+        if path.is_file():
+            shutil.copy2(path, args.output / name)
+    plan = {
+        "INVALID_MODEL": True, "purpose": "capacity and throughput experiment; generated contents are invalid",
+        "model_id": source["model_id"], "revision": source["revision"],
+        "keep_layers": args.keep_layers, "logical_layers": 48,
+        "alias_rule": "logical layer modulo keep_layers; GPU cache keeps original logical layer identity",
+        "index_sha256": hashlib.sha256((args.output / "model.safetensors.index.json").read_bytes()).hexdigest(),
+        "download_bytes": sum(files[name] for name in selected),
+        "selected_shards": sorted(selected), "completed": [],
+    }
+    report = args.output / "INVALID-EXPERT-ALIASES.json"
+    report.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({k: v for k, v in plan.items() if k not in {"selected_shards", "completed"}}, indent=2), flush=True)
+    if args.plan_only:
+        return
+
+    # 兼容 API 不传 file_size/SHA，显式元数据才会启用 Range 并验证完整下载。
+    remote = {file.path: file for file in api.list_repo_files(source["model_id"], "model", revision=source["revision"])}
+    for name in selected:
+        if remote[name].size != files[name] or not remote[name].sha256:
+            raise ValueError(f"source size changed or SHA-256 is missing: {name}")
+
+    def download(name):
+        started = time.monotonic()
+        api.downloader.download_file(source["model_id"], "model", name, revision=source["revision"],
+                                     local_dir=args.output, file_size=files[name], expected_sha256=remote[name].sha256)
+        path = args.output / name
+        if path.stat().st_size != files[name]:
+            raise RuntimeError(f"wrong downloaded size: {name}")
+        return {"name": name, "bytes": files[name], "sha256": remote[name].sha256,
+                "seconds": round(time.monotonic() - started, 2)}
+
+    # 先下载一个小于完整 PLE shard 的专家文件，及时得出实际下载速率。
+    with ThreadPoolExecutor(max_workers=args.workers) as pool:
+        futures = [pool.submit(download, name) for name in sorted(selected)]
+        for future in as_completed(futures):
+            item = future.result()
+            plan["completed"].append(item)
+            temporary = report.with_suffix(".tmp")
+            temporary.write_text(json.dumps(plan, indent=2) + "\n", encoding="utf-8")
+            temporary.replace(report)
+            print(f"completed {len(plan['completed'])}/{len(selected)}: {item}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/prepare_range_resume.py b/tools/prepare_range_resume.py
new file mode 100644
