+}
+#define FREETOKEN_GGUF_WAVE_MMVQ(...) \
+    if (!g_wave_off) { wave_launch<__VA_ARGS__>(weights, x_q8_1, y, n_in, n_out, ncols, stream); launch_check(); return; }
+#else
+#define FREETOKEN_GGUF_WAVE_MMVQ(...)
+#endif
