+    validate_pointer(weights);
+    validate_pointer(x_q8_1);
+    validate_pointer(y);
+    validate_stream(stream);
+    FREETOKEN_GGUF_WAVE_MMVQ(SmallTraits<Weight, Qi>)
+    if (ncols > 1) {
+        launch_multi<SmallTraits<Weight, Qi>>(weights, x_q8_1, y, n_in, n_out, ncols, stream);
+        launch_check();
