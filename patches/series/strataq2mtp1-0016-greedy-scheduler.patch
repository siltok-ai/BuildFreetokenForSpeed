diff --git a/python/freetoken/models/qwen4_exp/mtp_draft_graph.py b/python/freetoken/models/qwen4_exp/mtp_draft_graph.py
new file mode 100644
index 0000000..671f5c9
--- /dev/null
+++ b/python/freetoken/models/qwen4_exp/mtp_draft_graph.py
@@ -0,0 +1,98 @@
+"""Owned greedy draft-chain graphs with GPU positions and FreeToken paged attention."""
+from __future__ import annotations
+import torch
+from freetoken.kernel.triton.qsa import qsa_sparse_paged_attention
+
+class DraftGraphs:
+
+    def __init__(self, draft, stream, *, attention_width):
+        """Own compressed draft weights/KV; borrow target embedding, head and RoPE."""
+        if not 0 < attention_width <= draft.max_context or draft.max_context % 64:
+            raise ValueError('Draft graph requires a bounded page-aligned context')
+        self.draft = draft
+        self.stream = stream
+        device = draft.device
+        self.cell = torch.zeros(1, device=device, dtype=torch.int32)
+        self.r = torch.zeros((1, 10240), device=device, dtype=torch.float32)
+        self.token = torch.zeros(1, device=device, dtype=torch.int32)
+        self.candidates = torch.empty(3, device=device, dtype=torch.int32)
+        self.columns = torch.arange(attention_width, device=device, dtype=torch.int32)[None, :]
+        self.table = torch.arange(draft.max_context // 64, device=device, dtype=torch.int32)[None, :]
+        self.mapping = torch.zeros(1, device=device, dtype=torch.int32)
+        self.keys = draft.keys.view(-1, 64, 2, 256)
+        self.values = draft.values.view(-1, 64, 2, 256)
+        self.catchup_r = torch.zeros((3, 10240), device=device, dtype=torch.float32)
+        self.catchup_tokens = torch.zeros(3, device=device, dtype=torch.int32)
+        self.catchup_start = torch.zeros(1, device=device, dtype=torch.int32)
+        self.chains = {}
+        self.catchup = {}
+        self.attention_width = attention_width
+        key_before = draft.keys[:3].clone()
+        value_before = draft.values[:3].clone()
+        try:
+            for count in range(1, 4):
+
+                def chain():
+                    for row in range(count):
+                        token, residual = draft.step(self.r, self.token, 0, positions=self.cell, attend=self.attend)
+                        self.r.copy_(residual)
+                        self.token.copy_(token)
+                        self.candidates[row].copy_(token[0])
+                        self.cell.add_(1)
+                self.cell.zero_()
+                chain()
+                self.cell.zero_()
+                torch.cuda.synchronize()
+                graph = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(graph, stream=stream):
+                    chain()
+                self.chains[count] = graph
+
+                def catchup():
+                    r = draft.initial_residual(self.catchup_r[:count], self.catchup_tokens[:count])
+                    x, _ = draft.mix('attn_hyper_connection', r)
+                    positions = self.catchup_start + torch.arange(count, device=device, dtype=torch.int32)
+                    draft.key_value(x, positions)
+                catchup()
+                torch.cuda.synchronize()
+                graph = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(graph, stream=stream):
+                    catchup()
+                self.catchup[count] = graph
+        finally:
+            draft.keys[:3].copy_(key_before)
+            draft.values[:3].copy_(value_before)
+            torch.cuda.synchronize()
+
+    def attend(self, q, positions):
+        """Mask future/private speculative cells on device before paged FP32 attention."""
+        indices = torch.where(self.columns <= positions[0], self.columns, -1).to(torch.int32)
+        return qsa_sparse_paged_attention(q.reshape(1, 24, 256), self.keys, self.values, indices, self.table, self.mapping, num_stages=1).reshape(1, 24, 1, 256)
+
+    def chain(self, residual, token, cell, count):
+        """Launch one draft chain and read its candidates once on the host."""
+        if count not in self.chains or cell < 0 or cell + count > self.attention_width:
+            raise ValueError('Draft chain is outside the captured attention capacity')
+        self.r.copy_(residual)
+        self.token.fill_(int(token))
+        self.cell.fill_(cell)
+        self.chains[count].replay()
+        return self.candidates[:count].cpu().tolist()
+
+    def prime(self, residuals, tokens, start):
+        """Build only K/V from verified target residuals and next tokens."""
+        count = len(tokens)
+        if count not in self.catchup or start + count > self.attention_width:
+            raise ValueError('Draft catch-up is outside the captured capacity')
+        self.catchup_r[:count].copy_(residuals)
+        self.catchup_tokens[:count].copy_(tokens)
+        self.catchup_start.fill_(start)
+        self.catchup[count].replay()
+
+    def close(self):
+        """Destroy owned graphs after their users drain; borrowed target weights stay owned by the model."""
+        torch.cuda.synchronize()
+        for graph in [*self.chains.values(), *self.catchup.values()]:
+            graph.reset()
+        self.chains.clear()
+        self.catchup.clear()
diff --git a/python/freetoken/models/qwen4_exp/mtp_drafter.py b/python/freetoken/models/qwen4_exp/mtp_drafter.py
new file mode 100644
index 0000000..7f3be97
--- /dev/null
+++ b/python/freetoken/models/qwen4_exp/mtp_drafter.py
@@ -0,0 +1,123 @@
+"""FreeToken-kernel MTP calibration prototype; greedy single request, dense draft attention."""
+from __future__ import annotations
+import hashlib
+import json
+from pathlib import Path
+import torch
+import torch.nn.functional as F
+from freetoken.kernel.gguf_quant import compressed_linear, gguf_gemma_rmsnorm
+from freetoken.kernel.gguf_native import bf16_gemv
+from freetoken.kernel.triton.hc import grouped_gemma_rmsnorm, hc_silu, hc_gate_mix, hc_combine
+from freetoken.moe.fused_q2_q8 import fused_experts_q2_q8
+
+class MtpDrafter:
+
+    def __init__(self, runtime: Path, main_model, *, max_context=8192):
+        """Own compressed draft weights/KV; borrow target embedding, head and RoPE."""
+        manifest = json.loads((runtime / 'runtime.json').read_text(encoding='utf-8'))
+        if manifest['status'] != 'packed_unvalidated_runtime' or len(manifest['tensors']) != 31:
+            raise ValueError('MTP runtime conversion is incomplete')
+        self.device = main_model.model.embed_tokens.packed_0.device
+        self.embedding = main_model.model.embed_tokens
+        self.head = main_model.lm_head
+        self.rope = next((layer.self_attn.rotary for layer in main_model.model.layers.op_list if not layer._is_linear))
+        self.renormalize = main_model._config.norm_topk_prob
+        self.weights = {}
+        self.metadata = {}
+        for row in manifest['tensors']:
+            path = runtime / row['path']
+            with path.open('rb') as f:
+                if hashlib.file_digest(f, 'sha256').hexdigest() != row['sha256']:
+                    raise ValueError('MTP runtime bytes changed: ' + row['name'])
+            raw = bytearray(path.read_bytes())
+            dtype = torch.float32 if row['type_id'] == 0 else torch.uint8
+            weight = torch.frombuffer(raw, dtype=dtype).to(self.device)
+            if row['type_id'] == 0:
+                weight = weight.reshape(row['shape'])
+            elif row['name'] == 'mlp.experts.gate_up_proj':
+                weight = weight.reshape(512, 1280, 720)
+            elif row['name'] == 'mlp.experts.down_proj':
+                weight = weight.reshape(512, 2560, 180)
+            self.weights[row['name']] = weight
+            self.metadata[row['name']] = row
+            del raw
+        self.max_context = max_context
+        self.keys = torch.zeros((max_context, 2, 256), device=self.device, dtype=torch.float32)
+        self.values = torch.zeros_like(self.keys)
+        self.owned_bytes = sum((t.numel() * t.element_size() for t in self.weights.values())) + 2 * self.keys.numel() * self.keys.element_size()
+
+    def linear(self, name, x):
+        row = self.metadata[name]
+        return compressed_linear(self.weights[name], x, row['shape'][0], row['type_id'])
+
+    def initial_residual(self, residual, tokens):
+        """Normalize all four streams before shared per-stream fc_hidden projection."""
+        h = gguf_gemma_rmsnorm(residual, self.weights['pre_fc_norm_hidden.weight'])
+        hidden = self.linear('fc_hidden.weight', h.reshape(-1, 2560)).reshape(-1, 10240)
+        embedding = self.embedding.forward(tokens)
+        embedding = gguf_gemma_rmsnorm(embedding, self.weights['pre_fc_norm_embedding.weight'])
+        embedding = self.linear('fc_embedding.weight', embedding).repeat(1, 4)
+        return hidden + embedding
+
+    def mix(self, prefix, residual, *, inject=True):
+        """Use the validated FP32 HC path with merged BF16 down/inject projection."""
+        rn = grouped_gemma_rmsnorm(residual, self.weights[prefix + '.hc_norm.weight'], 1e-06, 4)
+        if inject:
+            down = bf16_gemv(self.weights[prefix + '.input_mix_weight_down.weight'], rn, 324, packed1=self.weights[prefix + '.block_inject_weight.weight'], first_rows=320)
+            lowrank, raw_inject = (down[:, :320], down[:, 320:324])
+        else:
+            lowrank = self.linear(prefix + '.input_mix_weight_down.weight', rn)
+            raw_inject = None
+        gates = self.linear(prefix + '.input_mix_weight_up.weight', hc_silu(lowrank, 4))
+        return (hc_gate_mix(rn, gates, 4), raw_inject)
+
+    def key_value(self, x, positions):
+        k = self.linear('self_attn.k_proj.weight', x).reshape(-1, 256)
+        k = gguf_gemma_rmsnorm(k, self.weights['self_attn.k_norm.weight']).reshape(-1, 512)
+        _, k = self.rope.forward(positions, torch.zeros_like(k), k)
+        v = self.linear('self_attn.v_proj.weight', x)
+        self.keys.index_copy_(0, positions.long(), k.reshape(-1, 2, 256))
+        self.values.index_copy_(0, positions.long(), v.reshape(-1, 2, 256))
+
+    def prime(self, residuals, next_tokens, *, start=0):
+        """Build only K/V from verified target residuals and next tokens."""
+        if start + len(next_tokens) > self.max_context:
+            raise ValueError('MTP draft context capacity exceeded')
+        for offset in range(0, len(next_tokens), 8):
+            tokens = next_tokens[offset:offset + 8]
+            r = self.initial_residual(residuals[offset:offset + 8], tokens)
+            x, _ = self.mix('attn_hyper_connection', r)
+            positions = torch.arange(start + offset, start + offset + len(tokens), device=self.device, dtype=torch.int32)
+            self.key_value(x, positions)
+
+    def step(self, residual, token, cell, *, positions=None, attend=None):
+        """Cell p pairs R_p with token p+1 and predicts p+2; recursive KV remains private."""
+        if not 0 <= cell < self.max_context:
+            raise ValueError('MTP draft cell is outside its own KV capacity')
+        if positions is None:
+            positions = torch.tensor([cell], device=self.device, dtype=torch.int32)
+        r = self.initial_residual(residual, token.reshape(1))
+        x, inject = self.mix('attn_hyper_connection', r)
+        self.key_value(x, positions)
+        qgate = self.linear('self_attn.q_proj.weight', x).reshape(1, 24, 512)
+        q = qgate[:, :, :256].contiguous().reshape(-1, 256)
+        q = gguf_gemma_rmsnorm(q, self.weights['self_attn.q_norm.weight']).reshape(1, 6144)
+        q, _ = self.rope.forward(positions, q, torch.zeros((1, 512), device=self.device, dtype=torch.float32))
+        if attend is None:
+            attended = F.scaled_dot_product_attention(q.reshape(1, 24, 1, 256), self.keys[:cell + 1].permute(1, 0, 2).unsqueeze(0), self.values[:cell + 1].permute(1, 0, 2).unsqueeze(0), enable_gqa=True)
+        else:
+            attended = attend(q, positions)
+        attended = attended.reshape(1, 6144) * qgate[:, :, 256:].reshape(1, 6144).sigmoid()
+        r = hc_combine(r, self.linear('self_attn.o_proj.weight', attended), inject, 4)
+        x, inject = self.mix('mlp_hyper_connection', r)
+        router = self.linear('mlp.gate.weight', x)
+        scores, ids = router.topk(10, dim=-1)
+        weights = scores.softmax(-1) if self.renormalize else router.softmax(-1).gather(-1, ids)
+        routed = fused_experts_q2_q8(x, self.weights['mlp.experts.gate_up_proj'], self.weights['mlp.experts.down_proj'], weights.contiguous(), ids.to(torch.int32).contiguous())
+        shared = F.silu(self.linear('mlp.shared_expert.gate_proj.weight', x)) * self.linear('mlp.shared_expert.up_proj.weight', x)
+        shared = self.linear('mlp.shared_expert.down_proj.weight', shared)
+        gate = self.linear('mlp.shared_expert_gate.weight', x).sigmoid()
+        r = hc_combine(r, routed + gate * shared, inject, 4)
+        mixed, _ = self.mix('hyper_connection_mixer', r, inject=False)
+        logits = self.head.quant_method.apply(self.head, mixed)
+        return (logits.argmax(-1).to(torch.int32), r)
diff --git a/python/freetoken/models/qwen4_exp/mtp_runtime.py b/python/freetoken/models/qwen4_exp/mtp_runtime.py
new file mode 100644
index 0000000..01f587f
--- /dev/null
+++ b/python/freetoken/models/qwen4_exp/mtp_runtime.py
@@ -0,0 +1,215 @@
+"""One-request greedy MTP windows with owned transactions and native scheduler delivery."""
+from __future__ import annotations
+
+import copy
+from typing import NamedTuple
+
+import torch
+
+from freetoken.attention.linear import build_fla_metadata
+from freetoken.core import Batch
+from .mtp_draft_graph import DraftGraphs
+from .mtp_state import MTP_LAST_RESIDUAL
+
+
+class DeliveryLimit(NamedTuple):
+    count: int
+    finished: bool
+
+
+def verified_prefix(candidates, picks, eos_ids, ignore_eos):
+    accepted = 0
+    for draft, target in zip(candidates, picks):
+        if draft != target or (not ignore_eos and draft in eos_ids):
+            break
+        accepted += 1
+    return [*candidates[:accepted], picks[accepted]]
+
+
+class MtpRuntime:
+    def __init__(self, engine, drafter):
+        self.engine = engine
+        self.draft = drafter
+        self.ple = engine.model._ple_table
+        self.graphs = {}
+        self.draft_graphs = None
+        self.active_owner = None
+        self.rounds = []
+        self.prepare_graphs()
+
+    @property
+    def pool(self):
+        return self.engine.linear_state_pool
+
+    @property
+    def aux(self):
+        return self.engine.kv_cache.mtp_state
+
+    @property
+    def raw(self):
+        return self.engine.model.model._mtp_residual_capture
+
+    def eligible(self, batch):
+        if not batch.is_decode or len(batch.reqs) != 1:
+            return False
+        req = batch.reqs[0]
+        return (req.sampling_params.is_greedy and not req.mm_items and req.extend_len == 1
+                and 0 < req.cached_len < self.draft.max_context and req.remain_len > 0)
+
+    def prepare_graphs(self):
+        if len(self.pool.reserved_slot_ids) != 4:
+            raise ValueError('MTP needs four exclusively reserved transaction slots')
+        self.dst = torch.tensor(self.pool.reserved_slot_ids, device=self.engine.device, dtype=torch.int64)
+        self.rings = torch.empty((4, *self.engine.kv_cache._pending_ring.shape[1:]),
+                                 device=self.engine.device, dtype=self.engine.kv_cache._pending_ring.dtype)
+        for count in (1, 2, 3, 4):
+            req = copy.copy(self.engine.dummy_req)
+            req.cached_len, req.device_len = 1, 1 + count
+            req.input_ids = torch.zeros(1 + count, dtype=torch.int32, device='cpu')
+            req.mamba_ping_pong = None
+            batch = Batch([req], 'verify')
+            batch.padded_reqs = [req]
+            batch.input_ids = torch.zeros(count, device=self.engine.device, dtype=torch.int32)
+            batch.positions = torch.arange(1, count + 1, device=self.engine.device, dtype=torch.int32)
+            dummy_base = self.engine.num_pages * self.engine.config.page_size
+            batch.out_loc = dummy_base + batch.positions
+            batch.linear_table_idx = torch.tensor([0], device=self.engine.device, dtype=torch.int32)
+            batch.fla_metadata = build_fla_metadata(batch, self.engine.device)
+            fla = batch.fla_metadata
+            fla.track_dst = self.dst[:count]
+            fla.track_boundary_row = torch.arange(1, count + 1, device=self.engine.device)
+            batch.mtp_ring_snapshots = self.rings
+            self.engine.attn_backend.prepare_metadata(batch)
+            for _ in range(2):
+                with self.engine.ctx.forward_batch(batch), self.engine.model.forward_host_ctx(batch, False):
+                    hidden = self.engine.model.model.forward(batch.input_ids, batch)
+                    self.engine.model.lm_head.quant_method.apply(self.engine.model.lm_head, hidden)
+            torch.cuda.synchronize(self.engine.device)
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph, stream=self.engine.stream):
+                with self.engine.ctx.forward_batch(batch):
+                    hidden = self.engine.model.model.forward(batch.input_ids, batch)
+                    logits = self.engine.model.lm_head.quant_method.apply(self.engine.model.lm_head, hidden)
+                    picks = logits.argmax(-1).to(torch.int32)
+            self.graphs[count] = (batch, graph, picks)
