@@ -0,0 +1,100 @@
+"""Fused Clover greedy penalties, mask, argmax and normalized confidence.
+
+Semantics: DiffuSpace/Clover-35B-A3B-Preview@4b0402b65e523d0183a14c431955438714cb16ff,
+sampling_clover_moe.py (Apache-2.0). Independent tiled online-softmax implementation.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _pick(LOGITS, COUNTS, BLOCK_IDS, PICKS, CONFIDENCE, STRIDE: tl.constexpr,
+          V: tl.constexpr, W: tl.constexpr, LENGTH, MASK: tl.constexpr,
+          PRESENCE: tl.constexpr, FREQUENCY: tl.constexpr, REPETITION: tl.constexpr,
+          LENGTH_BIAS: tl.constexpr, LENGTH_START: tl.constexpr, LENGTH_WINDOW: tl.constexpr,
+          THINK_BIAS: tl.constexpr, THINK_START: tl.constexpr, THINK_WINDOW: tl.constexpr,
+          THINK_ID: tl.constexpr, STOP_IDS: tl.constexpr, ACTIVE: tl.constexpr,
+          TILE: tl.constexpr, BLOCK_W: tl.constexpr):
+    row = tl.program_id(0)
+    lane = tl.arange(0, TILE)
+    maximum = tl.full((TILE,), -float("inf"), tl.float32)
+    normalizer = tl.zeros((TILE,), tl.float32)
+    winner = tl.full((TILE,), 2147483647, tl.int32)
+    length_bias = tl.minimum(tl.maximum((LENGTH + row + 1. - LENGTH_START) / LENGTH_WINDOW, 0.), 1.) * LENGTH_BIAS
+    if THINK_BIAS != 0.:
+        w = tl.arange(0, BLOCK_W)
+        block = tl.load(BLOCK_IDS + w, w < W, other=MASK)
+        visible = tl.sum(((block == THINK_ID) & (w < W)).to(tl.int32), 0) > 0
+        seen_close = tl.load(COUNTS + THINK_ID) > 0
+        think_bias = tl.where(visible | seen_close, 0.,
+            tl.minimum(tl.maximum((LENGTH + row + 1. - THINK_START) / THINK_WINDOW, 0.), 1.) * THINK_BIAS)
+    for start in range(tl.cdiv(V, TILE)):
+        token = start * TILE + lane
+        value = tl.load(LOGITS + row * STRIDE + token, token < V, other=-float("inf")).to(tl.float32)
+        value = tl.where(token == MASK, -float("inf"), value)
+        if ACTIVE:
+            count = tl.load(COUNTS + token, token < V, 0)
+            if FREQUENCY != 0.:
+                value = value - count.to(tl.float32) * FREQUENCY
+            if PRESENCE != 0.:
+                value = value - (count > 0).to(tl.float32) * PRESENCE
+            if REPETITION != 1.:
+                adjusted = tl.where(value < 0., value * REPETITION, tl.div_rn(value, REPETITION))
+                value = tl.where(count > 0, adjusted, value)
+        if LENGTH_BIAS != 0.:
+            for stop in tl.static_range(len(STOP_IDS)):
+                value = tl.where(token == STOP_IDS[stop], value + length_bias, value)
+        if THINK_BIAS != 0.:
+            value = tl.where(token == THINK_ID, value + think_bias, value)
+        new_max = tl.maximum(maximum, value)
+        normalizer = tl.where(new_max == -float("inf"), 0.,
+            normalizer * tl.exp(maximum - new_max) + tl.exp(value - new_max))
+        winner = tl.where((value > maximum) | ((value == maximum) & (token < winner)), token, winner)
+        maximum = new_max
+    row_max = tl.max(maximum, 0)
+    denominator = tl.sum(normalizer * tl.exp(maximum - row_max), 0)
+    token = tl.min(tl.where(maximum == row_max, winner, 2147483647), 0)
+    tl.store(PICKS + row, token)
+    tl.store(CONFIDENCE + row, 1. / denominator)
+
+
+@triton.jit
+def _resolve(BLOCK_IDS, PENDING, PICKS, CONFIDENCE, RESULT, W: tl.constexpr,
+             THRESHOLD: tl.constexpr, TILE: tl.constexpr):
+    row = tl.arange(0, TILE)
+    pending = tl.load(PENDING + row, row < W, other=0)
+    confidence = tl.load(CONFIDENCE + row, row < W, other=-float("inf"))
+    confidence = tl.where(pending, confidence, -float("inf"))
+    transfer = pending & (confidence > THRESHOLD)
+    count = tl.sum(transfer.to(tl.int32), 0)
+    best = tl.max(confidence, 0)
+    fallback = tl.min(tl.where((confidence == best) & pending, row, 2147483647), 0)
+    transfer = transfer | (pending & (count == 0) & (row == fallback))
+    block = tl.load(BLOCK_IDS + row, row < W, other=0)
+    pick = tl.load(PICKS + row, row < W, other=0)
+    tl.store(BLOCK_IDS + row, tl.where(transfer, pick, block), row < W)
+    tl.store(PENDING + row, pending & ~transfer, row < W)
+    tl.store(RESULT, tl.sum(transfer.to(tl.int32), 0))
+    tl.store(RESULT + 1, tl.sum((pending & ~transfer).to(tl.int32), 0))
+
+
+def pick_with_confidence(logits, state, block, mask_id):
+    gen = state.gen
+    rows = logits.shape[0]
+    picks = torch.empty(rows, dtype=torch.int32, device=logits.device)
+    confidence = torch.empty(rows, dtype=torch.float32, device=logits.device)
+    _pick[(rows,)](logits, state.counts if state.active else logits, block, picks, confidence,
+        logits.stride(0), logits.shape[-1], block.numel(), state.length, mask_id,
+        gen.presence_penalty, gen.frequency_penalty, gen.repetition_penalty,
+        gen.dllm_length_penalty, gen.dllm_length_penalty_start, gen.dllm_length_penalty_window,
+        gen.dllm_think_end_bias, gen.dllm_think_end_start, gen.dllm_think_end_window,
+        gen.dllm_think_end_token_id or 0, tuple(state.stop_ids), state.active,
+        2048, triton.next_power_of_2(block.numel()), num_warps=8, enable_fp_fusion=False)
+    return picks, confidence
+
+
+def resolve_step(block, pending, picks, confidence, threshold, result):
+    _resolve[(1,)](block, pending, picks, confidence, result, block.numel(), threshold,
+                   triton.next_power_of_2(block.numel()))
diff --git a/python/freetoken/kernel/triton/clover_store.py b/python/freetoken/kernel/triton/clover_store.py
new file mode 100644
index 0000000000000000000000000000000000000000..2ecfb9503ee36f8c763ac54b1c20590022ca59b1
--- /dev/null
+++ b/python/freetoken/kernel/triton/clover_store.py
@@ -0,0 +1,25 @@
+"""Clover verify stores only owned, valid prefix rows of a padded block."""
+
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _store(KC, VC, LOC, K, V, VALID, KS: tl.constexpr, VS: tl.constexpr,
+           FEATURES: tl.constexpr, TILE: tl.constexpr):
+    row = tl.program_id(0)
+    col = tl.program_id(1) * TILE + tl.arange(0, TILE)
+    valid = tl.load(VALID + row)
+    loc = tl.load(LOC + row, valid, other=0).to(tl.int64)
+    k = tl.load(K + row * KS + col, valid & (col < FEATURES), other=0)
+    v = tl.load(V + row * VS + col, valid & (col < FEATURES), other=0)
+    tl.store(KC + loc * FEATURES + col, k, valid & (col < FEATURES))
+    tl.store(VC + loc * FEATURES + col, v, valid & (col < FEATURES))
+
+
+def store_verify_kv(keys, values, locations, k, v, valid):
+    rows, features = k.shape[0], keys.shape[1] * keys.shape[2]
+    k, v = k.reshape(rows, features), v.reshape(rows, features)
+    assert k.stride(1) == v.stride(1) == 1
+    _store[(rows, triton.cdiv(features, 256))](keys, values, locations, k, v, valid,
+        k.stride(0), v.stride(0), features, 256)
diff --git a/python/freetoken/kernel/triton/clover_verify.py b/python/freetoken/kernel/triton/clover_verify.py
new file mode 100644
index 0000000000000000000000000000000000000000..0dd302152de43eaf5abc97c6d92ea894ad7da3ae
--- /dev/null
+++ b/python/freetoken/kernel/triton/clover_verify.py
@@ -0,0 +1,154 @@
+"""Response penalties and linear-chain verification without hypothetical state copies."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _adjust(value, token, row, COUNTS, INPUTS, LENGTH, MASK: tl.constexpr,
+            V: tl.constexpr, ACTIVE: tl.constexpr, HYPOTHETICAL: tl.constexpr,
+            PARAMS: tl.constexpr):
+    PRESENCE: tl.constexpr = PARAMS[0]
+    FREQUENCY: tl.constexpr = PARAMS[1]
+    REPETITION: tl.constexpr = PARAMS[2]
+    LENGTH_BIAS: tl.constexpr = PARAMS[3]
+    LENGTH_START: tl.constexpr = PARAMS[4]
+    LENGTH_WINDOW: tl.constexpr = PARAMS[5]
+    THINK_BIAS: tl.constexpr = PARAMS[6]
+    THINK_START: tl.constexpr = PARAMS[7]
+    THINK_WINDOW: tl.constexpr = PARAMS[8]
+    THINK_ID: tl.constexpr = PARAMS[9]
+    STOP_IDS: tl.constexpr = PARAMS[10]
+    value = tl.where(token == MASK, -float('inf'), value)
+    if ACTIVE:
+        count = tl.load(COUNTS + token, token < V, other=0)
+        if HYPOTHETICAL:
+            for index in range(1, row + 1):
+                previous = tl.load(INPUTS + index)
+                count += (token == previous).to(count.dtype)
+        if FREQUENCY != 0.:
+            value = value - count.to(tl.float32) * FREQUENCY
+        if PRESENCE != 0.:
+            value = value - (count > 0).to(tl.float32) * PRESENCE
+        if REPETITION != 1.:
+            # Torch inverts the Python scalar before converting that reciprocal to FP32.
+            reciprocal: tl.constexpr = 1. / REPETITION
+            scaled = tl.where(value < 0, value * REPETITION, value * reciprocal)
+            value = tl.where(count > 0, scaled, value)
+    position = LENGTH + row + 1.
+    if LENGTH_BIAS != 0.:
+        bias = tl.minimum(tl.maximum((position - LENGTH_START) / LENGTH_WINDOW, 0.), 1.) * LENGTH_BIAS
+        for index in tl.static_range(len(STOP_IDS)):
+            value = tl.where(token == STOP_IDS[index], value + bias, value)
+    if THINK_BIAS != 0.:
+        closed = tl.load(COUNTS + THINK_ID) > 0
+        if HYPOTHETICAL:
+            # Row zero sees the pending input; later rows also count their proposals.
+            for index in range(1, row + 1):
+                closed |= tl.load(INPUTS + index) == THINK_ID
+            closed |= tl.load(INPUTS + row) == THINK_ID
+        bias = tl.where(closed, 0.,
+            tl.minimum(tl.maximum((position - THINK_START) / THINK_WINDOW, 0.), 1.) * THINK_BIAS)
+        value = tl.where(token == THINK_ID, value + bias, value)
+    return value
+
+
+@triton.jit
+def _penalize(LOGITS, OUT, COUNTS, INPUTS, STRIDE: tl.constexpr, V: tl.constexpr,
+              LENGTH, MASK: tl.constexpr, ACTIVE: tl.constexpr,
+              HYPOTHETICAL: tl.constexpr, PARAMS: tl.constexpr, TILE: tl.constexpr):
+    row = tl.program_id(0)
+    token = tl.program_id(1) * TILE + tl.arange(0, TILE)
+    value = tl.load(LOGITS + row * STRIDE + token, token < V, other=-float('inf')).to(tl.float32)
+    value = _adjust(value, token, row, COUNTS, INPUTS, LENGTH, MASK, V,
+                    ACTIVE, HYPOTHETICAL, PARAMS)
+    tl.store(OUT + row * V + token, value, token < V)
+
+
+@triton.jit
+def _verify_rows(LOGITS, COUNTS, INPUTS, PICKS, MATCHES, STRIDE: tl.constexpr,
+                 V: tl.constexpr, W: tl.constexpr, LENGTH, MASK: tl.constexpr,
+                 ACTIVE: tl.constexpr, PARAMS: tl.constexpr, EXACT: tl.constexpr,
+                 RATIO: tl.constexpr, DELTA: tl.constexpr, TILE: tl.constexpr):
+    row = tl.program_id(0)
+    lane = tl.arange(0, TILE)
+    maximum = tl.full((TILE,), -float('inf'), tl.float32)
+    winner = tl.full((TILE,), 2147483647, tl.int32)
+    normalizer = tl.zeros((TILE,), tl.float32)
+    for start in range(tl.cdiv(V, TILE)):
+        token = start * TILE + lane
+        value = tl.load(LOGITS + row * STRIDE + token, token < V, other=-float('inf')).to(tl.float32)
+        value = _adjust(value, token, row, COUNTS, INPUTS, LENGTH, MASK, V, ACTIVE, True, PARAMS)
+        new_max = tl.maximum(maximum, value)
+        if not EXACT:
+            normalizer = tl.where(new_max == -float('inf'), 0.,
+                normalizer * tl.exp(maximum - new_max) + tl.exp(value - new_max))
+        winner = tl.where((value > maximum) | ((value == maximum) & (token < winner)), token, winner)
+        maximum = new_max
+    row_max = tl.max(maximum, 0)
+    pick = tl.min(tl.where(maximum == row_max, winner, 2147483647), 0)
+    proposal = tl.load(INPUTS + row + 1, row < W - 1, other=0)
+    if EXACT:
+        match = pick == proposal
+    else:
+        denominator = tl.sum(normalizer * tl.exp(maximum - row_max), 0)
+        entropy_parts = tl.zeros((TILE,), tl.float32)
+        for start in range(tl.cdiv(V, TILE)):
+            token = start * TILE + lane
+            value = tl.load(LOGITS + row * STRIDE + token, token < V, other=-float('inf')).to(tl.float32)
+            value = _adjust(value, token, row, COUNTS, INPUTS, LENGTH, MASK, V, ACTIVE, True, PARAMS)
+            probability = tl.exp(value - row_max) / denominator
+            entropy_parts -= probability * tl.log(tl.maximum(probability, 1.e-12))
+        entropy = tl.sum(entropy_parts, 0)
+        value = tl.load(LOGITS + row * STRIDE + proposal).to(tl.float32)
+        value = _adjust(value, proposal, row, COUNTS, INPUTS, LENGTH, MASK, V, ACTIVE, True, PARAMS)
+        probability = tl.exp(value - row_max) / denominator
+        match = (probability >= tl.minimum(RATIO, DELTA * tl.exp(-entropy))) & (probability > 0)
+    tl.store(PICKS + row, pick)
+    tl.store(MATCHES + row, match & (row < W - 1))
+
+
+@triton.jit
+def _deliver(INPUTS, PICKS, MATCHES, PACKET, W: tl.constexpr, TILE: tl.constexpr):
+    row = tl.arange(0, TILE)
+    matches = tl.load(MATCHES + row, row < W - 1, other=0)
+    accepted = tl.min(tl.where((row < W - 1) & ~matches, row, W - 1), 0)
+    bonus = tl.load(PICKS + accepted)
+    proposal = tl.load(INPUTS + row + 1, row < W - 1, other=0)
+    tl.store(PACKET, accepted)
+    tl.store(PACKET + 1 + row, tl.where(row < accepted, proposal, bonus), row < W)
+
+
+def _parameters(state):
+    g = state.gen
+    return (g.presence_penalty, g.frequency_penalty, g.repetition_penalty,
+        g.dllm_length_penalty, g.dllm_length_penalty_start, g.dllm_length_penalty_window,
+        g.dllm_think_end_bias, g.dllm_think_end_start, g.dllm_think_end_window,
+        g.dllm_think_end_token_id or 0, tuple(state.stop_ids))
+
+
+def penalize_logits(logits, state, mask_id, inputs=None, *, output=None):
+    rows, vocab = logits.shape
+    if output is None:
+        output = torch.empty((rows, vocab), dtype=torch.float32, device=logits.device)
+    _penalize[(rows, triton.cdiv(vocab, 1024))](logits, output,
+        state.counts if state.active else logits, inputs if inputs is not None else logits,
+        logits.stride(0), vocab, state.length, mask_id, state.active, inputs is not None,
+        _parameters(state), 1024, enable_fp_fusion=False)
+    return output
+
+
+def verify_and_deliver(logits, inputs, state, mask_id, *, rule, ratio=.9, delta=.6):
+    if rule not in ('exact', 'threshold'):
+        raise ValueError('Unknown Clover acceptance rule')
+    width, vocab = logits.shape
+    picks = torch.empty(width, dtype=torch.int32, device=logits.device)
+    matches = torch.empty(width, dtype=torch.bool, device=logits.device)
+    packet = torch.empty(width + 1, dtype=torch.int32, device=logits.device)
+    _verify_rows[(width,)](logits, state.counts if state.active else logits, inputs,
+        picks, matches, logits.stride(0), vocab, width, state.length, mask_id,
+        state.active, _parameters(state), rule == 'exact', ratio, delta, 1024,
+        num_warps=4, enable_fp_fusion=False)
+    _deliver[(1,)](inputs, picks, matches, packet, width, triton.next_power_of_2(width))
+    return packet
