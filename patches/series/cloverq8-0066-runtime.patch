+        logits[break_row, 7] = -10
+        logits[break_row, 11] = 20
+    reference = logits.float().clone()
+    reference[:, mask] = -float('inf')
+    hypothetical = copy.copy(state)
+    hypothetical.counts = state.counts.clone()
+    for row in range(width):
