--- /dev/null
+++ b/python/freetoken/models/clover_moe/moe.py
@@ -0,0 +1,68 @@
+"""Clover-only short-prompt expert-union admission."""
+
+import torch
+
+from freetoken.core import get_global_ctx
+from freetoken.moe.fused import fused_topk
+from freetoken.models.qwen3_5_moe.moe import Qwen3_5MoE
+
+
+def admit_expert_union(cache, layer_id, indices):
+    """Compact raw routes to E carriers, admit once, and gather row slots."""
+    count = torch.zeros(cache.num_experts, device=indices.device, dtype=torch.int32)
+    flat = indices.reshape(-1).long()
+    count.scatter_add_(0, flat, torch.ones_like(flat, dtype=count.dtype))
+    experts = torch.arange(len(count), device=indices.device, dtype=indices.dtype)
+    carrier = torch.where(count > 0, experts, indices.flatten()[0]).reshape(
+        -1, indices.shape[-1]
+    )
+    cache.ensure_experts(layer_id, carrier)
+    cache.copy_missing()
+    return carrier.flatten()[indices.long()]
+
+
+class CloverMoE(Qwen3_5MoE):
+    def __init__(self, config, layer_id=None, *, prefix=""):
+        super().__init__(config, layer_id, prefix=prefix)
+        self.sparse_prefill_limit = 256
+
+    def forward(self, hidden_states):
+        cache = getattr(self.experts, "offload_cache", None)
+        if not (
+            get_global_ctx().batch.is_prefill
+            and cache is not None
+            and cache.quant_format in ("nvfp4", "clover_gguf")
+            and cache.decode_target == "gpu"
+            and cache.cache_policy == "lru"
+            and not cache.is_cpu_layer(self.experts.layer_id)
+            and hidden_states.shape[0] <= self.sparse_prefill_limit
+        ):
+            return super().forward(hidden_states)
+        # Existing NVFP4 prefill streams all 256 experts. Short desktop prompts
+        # can instead reuse the verified decode union/cache and unchanged GEMM.
+        router = self.gate.forward(hidden_states)
+        shared = self.shared_expert.forward(hidden_states) * torch.sigmoid(
+            self.shared_expert_gate.forward(hidden_states)
+        )
+        weights, indices = fused_topk(
+            hidden_states=hidden_states,
+            gating_output=router,
+            topk=self.experts.top_k,
+            renormalize=self.experts.renormalize,
+        )
+        # Admit the complete expert union with a fixed E-element carrier. Feeding
+        # N*top_k assignments to the LRU caused multi-minute LLVM compilation for
+        # N>32 on SM120. Duplicate the first active id in unused carrier positions;
+        # it admits no additional experts and preserves the existing LRU kernel.
+        slots = admit_expert_union(cache, self.experts.layer_id, indices)
+        routed = self.experts._expert_gemm(
+            cache,
+            hidden_states,
+            weights,
+            slots,
+            views=cache.bank_views(),
+            n=None,
+            alphas=cache.alphas_for_slots(self.experts.layer_id),
+            is_prefill=False,
+        )
+        return self.experts._maybe_all_reduce(routed) + shared
diff --git a/python/freetoken/models/clover_moe/packed.py b/python/freetoken/models/clover_moe/packed.py
new file mode 100644
index 0000000000000000000000000000000000000000..b6e244f094df8a4b3e97f4a8cf7fb42e571dd928
--- /dev/null
+++ b/python/freetoken/models/clover_moe/packed.py
@@ -0,0 +1,59 @@
+"""Packed Clover dense projections using the existing GGML Q8_1 CUDA kernels.
+
+Layout reference: Maphist0/llama.cpp-pub@cb09d4355d8bf968bb907c5de03cf42d8aa073ce,
+conversion/clover.py and conversion/qwen.py (MIT). No upstream code is copied.
+"""
+
+import torch
+
+from freetoken.layers import BaseOP, LinearReplicated
+from freetoken.models.qwen3_5_moe.weight import _DenseReader
+from freetoken.models.register import get_model_spec
+
+
+class CloverDenseGroups(_DenseReader):
+    def __init__(self):
+        super().__init__(None, get_model_spec("CloverMoeModelLM"))
+
+    def target(self, module):
+        parent, _, leaf = module.rpartition(".")
+        if leaf in ("in_proj_qkv", "in_proj_z"):
+            return parent + ".in_proj_qkvz", ("in_proj_qkv", "in_proj_z").index(leaf), 2
+        if leaf in ("in_proj_b", "in_proj_a"):
+            return parent + ".in_proj_ba", ("in_proj_b", "in_proj_a").index(leaf), 2
+        return super().target(module)
+
+
+class CloverPackedLinear(BaseOP):
+    def __init__(self, rows, cols, quant_type, row_bytes):
+        self.weight = torch.empty(rows, row_bytes, dtype=torch.uint8)
+        self._rows = rows
+        self._cols = cols
+        self._type = quant_type
+
+    def forward(self, x):
+        from freetoken.kernel.gguf import ggml_mul_mat_a8, ggml_mul_mat_vec_a8
+
+        operation = ggml_mul_mat_vec_a8 if x.shape[0] == 1 else ggml_mul_mat_a8
+        return operation(self.weight, x, self._type, self._rows).to(x.dtype)
+
+
+def install_packed_linears(model, config):
+    """Replace only Clover GGUF linears; HF/NVFP4 and other families are unchanged."""
+    source = config.expert_source
+    for layer in model.model.layers.op_list:
+        if layer._is_linear:
+            mixer = layer.linear_attn
+            if not mixer._split_in_proj:
+                del mixer.in_proj
+                mixer._split_in_proj = True
+                mixer.in_proj_ba = LinearReplicated(config.hidden_size, 2 * mixer.num_v_heads, False)
+    for name, (rows, cols, kind, row_bytes) in source["dense"].items():
+        parent = model
+        parts = name.split(".")
+        for part in parts[:-1]:
+            parent = parent.op_list[int(part)] if part.isdigit() else getattr(parent, part)
+        setattr(parent, parts[-1], CloverPackedLinear(rows, cols, kind, row_bytes))
+    for index, layer in enumerate(model.model.layers.op_list):
+        layer.mlp.experts.gguf_types = source["types"][index]
+        layer.mlp.experts.gguf_row_bytes = source["row_bytes"][index]
diff --git a/python/freetoken/models/clover_moe/preview.py b/python/freetoken/models/clover_moe/preview.py
new file mode 100644
index 0000000000000000000000000000000000000000..98d80e31260620c5cec8b0a90a72b54bbf47103e
--- /dev/null
+++ b/python/freetoken/models/clover_moe/preview.py
@@ -0,0 +1,182 @@
+"""Read-only block preview and causal accepted-prefix transactions.
+
+Preview semantics: DiffuSpace/Clover-35B-A3B-Preview@4b0402b65e523d0183a14c431955438714cb16ff,
+modeling_clover_moe.py. Numerical preview kernels retain their SGLang source
+notices. Verify reuses FreeToken's existing FLA intermediate-state support.
+"""
+
+import torch
+
+
+from freetoken.kernel.causal_conv1d import causal_conv1d_varlen
+from freetoken.kernel.triton.attention import extend_paged_attention
+from freetoken.kernel.triton.clover_conv import clover_local_memory_conv
+from freetoken.kernel.triton.clover_coreset import clover_block_coreset_triton
+from freetoken.kernel.triton.clover_gdn import clover_local_memory_triton
+
+
+class CloverTransactions:
+    """One private verify window; live GDN advances only on explicit commit."""
+    def __init__(self, pool, max_width):
+        if max_width not in (8, 16, 32):
+            raise ValueError("Clover transaction width must be 8, 16 or 32")
+        self.capacity = max_width
+        self.recurrent = torch.empty((pool.recurrent_states.shape[0], max_width, *pool.recurrent_states.shape[2:]),
+                                     dtype=pool.recurrent_states.dtype, device=pool.device)
+        self.conv = torch.empty((pool.conv_states.shape[0], max_width, *pool.conv_states.shape[2:]),
+                                dtype=pool.conv_states.dtype, device=pool.device)
+        self.zero = torch.zeros(1, dtype=torch.int32, device=pool.device)
+        self.initial = torch.ones(1, dtype=torch.bool, device=pool.device)
+        self.width = 0
+        self.valid_width = 0
+        self.written = set()
+
+    def begin(self, width, valid_width=None):
+        if not 1 <= width <= self.capacity:
+            raise ValueError("Verify rows exceed the owned transaction capacity")
+        self.width = width
+        self.valid_width = width if valid_width is None else valid_width
+        if not 1 <= self.valid_width <= width:
+            raise ValueError("Valid verify rows exceed the physical transaction width")
+        self.written.clear()
+
+    def commit(self, pool, count, destination):
+        if (not 1 <= count <= self.valid_width
+                or self.written != set(range(self.recurrent.shape[0]))):
+            raise ValueError("Cannot commit an incomplete or out-of-range Clover prefix")
+        pool.recurrent_states[:, destination].copy_(self.recurrent[:, count - 1])
+        pool.conv_states[:, destination].copy_(self.conv[:, count - 1])
+
+    @property
+    def owned_bytes(self):
+        return sum(t.numel() * t.element_size() for t in (self.recurrent, self.conv, self.zero, self.initial))
+
+
+def _project(mixer, hidden):
+    total = hidden.shape[0]
+    if mixer._split_in_proj:
+        qkvz = mixer.in_proj_qkvz.forward(hidden)
+        raw, z = torch.split(qkvz, [mixer.conv_dim, mixer.value_dim], dim=-1)
+        b, a = torch.split(mixer.in_proj_ba.forward(hidden), [mixer.num_v_heads] * 2, dim=-1)
+    else:
+        raw, z, b, a = torch.split(mixer.in_proj.forward(hidden), mixer._in_proj_split, dim=-1)
+    return raw, z.reshape(total, mixer.num_v_heads, mixer.head_v_dim), b, a
+
+
+def gdn_forward(mixer, hidden, ctx, *, preview):
+    batch, pool = ctx.batch, ctx.linear_state_pool
+    source = getattr(batch, "clover_clean", pool)
+    if len(batch.reqs) != 1:
+        raise ValueError("Clover block forwards currently require one request")
+    raw, z, b, a = _project(mixer, hidden)
+    total, dtype = hidden.shape[0], hidden.dtype
+    indices = batch.fla_metadata.cache_indices
+    li = pool.local_index(mixer.layer_id)
+    if preview:
+        valid = batch.clover_valid
+        mixed = clover_local_memory_conv(raw, clean_conv_states=source.conv_states[li], cache_indices=indices,
+            conv_weights=mixer._conv_weight(), bias=None, activation="silu", block_size=total,
+            active_valid_mask=valid, conv_mode="independent_symmetric", conv_right_weight=mixer.conv_right_weight)
+    else:
+        transaction = batch.clover_transactions
+        if transaction.width != total:
+            raise ValueError("Clover verify input does not match the active transaction")
+        clean = source.conv_states[li].index_select(0, indices.long())
+        # Save raw-input windows before a causal-convolution implementation is
+        # allowed to overwrite its input. Scratch history never aliases live.
+        joined = torch.cat((clean[0].T, raw), dim=0)
+        transaction.conv[li, :total].copy_(joined.unfold(0, mixer.conv_kernel_size - 1, 1)[1:total + 1])
+        mixed = causal_conv1d_varlen(raw.T.contiguous().clone(), mixer._conv_weight(), clean.clone(),
+            batch.fla_metadata.cu_seqlens, transaction.zero, transaction.initial,
+            max_seq_len=total).T.contiguous()
+    qf, kf, vf = torch.split(mixed, [mixer.key_dim, mixer.key_dim, mixer.value_dim], dim=-1)
+    q = qf.reshape(1, total, mixer.num_k_heads, mixer.head_k_dim).to(dtype)
+    k = kf.reshape(1, total, mixer.num_k_heads, mixer.head_k_dim).to(dtype)
+    v = vf.reshape(1, total, mixer.num_v_heads, mixer.head_v_dim).to(dtype)
+    if preview:
+        g, _ = mixer._gate_params(a, b)
+        output = clover_local_memory_triton(q, k, v, g.reshape(1, total, mixer.num_v_heads),
+            clean_ssm_states=source.recurrent_states[li], cache_indices=indices, active_valid_mask=valid,
+            scale=mixer.head_k_dim ** -.5, softmax_logit_scale=mixer.bd_softmax_logit_scale,
+            softmax_history_bias=mixer.bd_softmax_history_bias, softmax_history_c=mixer.bd_softmax_history_c)
+    else:
+        from freetoken.kernel.fla import fused_sigmoid_gating_delta_rule_update
+
+        output = fused_sigmoid_gating_delta_rule_update(A_log=mixer.A_log, a=a, dt_bias=mixer.dt_bias,
+            softplus_beta=1., softplus_threshold=20., q=q, k=k, v=v, b=b,
+            initial_state_source=source.recurrent_states[li], initial_state_indices=indices,
+            scale=mixer.head_k_dim ** -.5, use_qk_l2norm_in_kernel=True,
+            cu_seqlens=batch.fla_metadata.cu_seqlens, disable_state_update=True,
+            intermediate_states_buffer=transaction.recurrent[li].unsqueeze(0),
+            intermediate_state_indices=transaction.zero)
+        transaction.written.add(li)
+    normalized = mixer.norm.forward(output.reshape(-1, mixer.head_v_dim), z.reshape(-1, mixer.head_v_dim))
+    return mixer.out_proj.forward(normalized.reshape(total, -1))
+
+
+def attention_preview(mixer, hidden, ctx, *, preview=True):
+    batch = ctx.batch
+    req = batch.reqs[0]
+    q, k, v, gate = mixer._project(hidden)
+    width, prefix = hidden.shape[0], req.cached_len
+    kh, dim = mixer.num_kv, mixer.head_dim
+    keys = ctx.kv_cache.k_cache(mixer.layer_id).view(-1, kh, dim)
+    values = ctx.kv_cache.v_cache(mixer.layer_id).view(-1, kh, dim)
+    if not preview:
+        from freetoken.kernel.triton.clover_store import store_verify_kv
+
+        store_verify_kv(keys, values, batch.out_loc, k, v, batch.clover_valid)
+    metadata = batch.clover_attention
+    indices = metadata.get("indices")
+    if indices is None:
+        indices = ctx.page_table[req.table_idx, :prefix]
+    if getattr(batch, 'clover_kv_splits', 1) > 1:
+        from freetoken.kernel.triton.clover_attention import split_kv_attention
+
+        output = split_kv_attention(q,keys,values,indices,metadata['prefix_lens'],
+            k.reshape(width,kh,dim),v.reshape(width,kh,dim),preview=preview,
+            splits=batch.clover_kv_splits)
+    else:
+        output = extend_paged_attention(q, keys, values, metadata["q_indptr"], metadata["kv_indptr"],
+            indices, metadata["prefix_lens"], width, dim ** -.5,
+            k_extend=k.reshape(width, kh, dim), v_extend=v.reshape(width, kh, dim),
+            block_ends=metadata["block_ends"] if preview else None)
+    return mixer._combine(output, gate)
+
+
+def moe_preview(mixer, hidden, ctx):
+    router = mixer.gate.forward(hidden)
+    preview = getattr(ctx.batch, "clover_preview", False)
+    if preview and ctx.batch.clover_coreset_top_p < 1.:
+        router = clover_block_coreset_triton(router, hidden.shape[0], mixer.experts.top_k,
+                                            ctx.batch.clover_coreset_top_p)
+    if not preview and getattr(ctx.batch, "clover_valid", None) is not None:
+        # Padding reuses an existing route, so it cannot churn unrelated experts.
+        router = torch.where(ctx.batch.clover_valid[:, None], router, router[:1])
+    # The routed kernel can overwrite its input, so shared projections go first.
+    shared = mixer.shared_expert.forward(hidden) * torch.sigmoid(mixer.shared_expert_gate.forward(hidden))
+    return mixer.experts.forward(hidden_states=hidden, router_logits=router) + shared
+
+
+def block_forward(model, ctx, *, preview):
+    batch = ctx.batch
+    hidden = model.model.embed_tokens.forward(batch.input_ids)
+    residual = None
+    for layer in model.model.layers.op_list:
+        if residual is None:
+            residual = hidden
+            hidden = layer.input_layernorm.forward(hidden)
+        else:
+            hidden, residual = layer.input_layernorm.forward_add_residual(hidden, residual)
+        if layer._is_linear:
+            hidden = gdn_forward(layer.linear_attn, hidden, ctx, preview=preview)
+        elif preview or getattr(batch, "clover_valid", None) is not None:
+            hidden = attention_preview(layer.self_attn, hidden, ctx, preview=preview)
+        else:
+            hidden = layer.self_attn.forward(hidden)
+        hidden, residual = layer.post_attention_layernorm.forward_add_residual(hidden, residual)
+        hidden = (moe_preview(layer.mlp, hidden, ctx)
+                  if preview or getattr(batch, "clover_valid", None) is not None
+                  else layer.mlp.forward(hidden))
+    hidden, _ = model.model.norm.forward_add_residual(hidden, residual)
+    return model.lm_head.forward(hidden)
