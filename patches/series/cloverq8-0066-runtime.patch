+++ b/python/freetoken/models/clover_moe/model.py
@@ -0,0 +1,89 @@
+"""Clover causal model with explicit storage for the read-only preview weights.
+
+Architecture reference: DiffuSpace/Clover-35B-A3B-Preview,
+4b0402b65e523d0183a14c431955438714cb16ff/modeling_clover_moe.py.
+No HF implementation is copied here; causal operators reuse FreeToken's Qwen
+path, leaving ordinary Qwen and Flash-Next arithmetic unchanged.
+"""
+
+import torch
+
+from freetoken.core import get_global_ctx
+from freetoken.layers.norm import GemmaRMSNorm
+from freetoken.models.qwen3_5_moe.model import Qwen3_5ForCausalLM
+from .moe import CloverMoE
+
+
+class CloverPlusOneRMSNorm(GemmaRMSNorm):
+    """Keep checkpoint deltas until FP32 (1+w), as official Clover does."""
+
+    def __init__(self, size, eps):
+        super().__init__(size, eps)
+        from freetoken.kernel.triton.norm import gemma_rmsnorm, gemma_fused_add_rmsnorm
+
+        self.rmsnorm = gemma_rmsnorm
+        self.fused_add_rmsnorm = gemma_fused_add_rmsnorm
+
+
+class CloverMoeModelLM(Qwen3_5ForCausalLM):
+    def configure_runtime(self, config):
+        for layer in self.model.layers.op_list:
+            layer.mlp.sparse_prefill_limit = config.clover_sparse_prefill_limit
+
+    def place_input_embedding(self):
+        """Optional exact-byte mapped-host table; output weights remain resident."""
+        from freetoken.kernel.pinned import alloc_pinned_tensor, MappedHostBytes
+
+        embedding = self.model.embed_tokens
+        if self.lm_head.tied_embedding is not None:
+            raise ValueError("Mapped Clover input embeddings require an untied output head")
+        if hasattr(embedding, '_mapped_host'):
+            return embedding._mapped_host.owner.numel()
+        weight = embedding.weight
+        if not weight.is_cuda or torch.cuda.is_current_stream_capturing():
+            raise ValueError("Map Clover embeddings after loading and before graph capture")
+        host = alloc_pinned_tensor(weight.numel()*weight.element_size(), dtype=torch.uint8)
+        host.copy_(weight.view(torch.uint8).flatten().cpu())
+        mapping = MappedHostBytes(host)
+        view = mapping.cuda_view(weight.device).view(weight.dtype).reshape(weight.shape)
+        embedding._mapped_host = mapping
+        embedding.weight = view
+        return host.numel()
+
+    def __init__(self, config):
+        super().__init__(config)
+        self.model.norm = CloverPlusOneRMSNorm(config.hidden_size, config.rms_norm_eps)
+        for identifier, layer in enumerate(self.model.layers.op_list):
+            layer.mlp = CloverMoE(
+                config, identifier, prefix=f"model.layers.{identifier}.mlp"
+            )
+            layer.input_layernorm = CloverPlusOneRMSNorm(
+                config.hidden_size, config.rms_norm_eps
+            )
+            layer.post_attention_layernorm = CloverPlusOneRMSNorm(
+                config.hidden_size, config.rms_norm_eps
+            )
+            if not layer._is_linear:
+                layer.self_attn.q_norm = CloverPlusOneRMSNorm(
+                    config.head_dim, config.rms_norm_eps
+                )
+                layer.self_attn.k_norm = CloverPlusOneRMSNorm(
+                    config.head_dim, config.rms_norm_eps
+                )
+                continue
+            mixer = layer.linear_attn
+            mixer.conv_right_weight = torch.empty(
+                mixer.conv_dim, 1, mixer.conv_kernel_size - 1
+            )
+            mixer.bd_softmax_logit_scale = torch.empty(mixer.num_v_heads)
+            mixer.bd_softmax_history_bias = torch.empty(mixer.num_v_heads)
+            mixer.bd_softmax_history_c = torch.empty(mixer.num_v_heads)
+
+    def forward(self):
+        ctx = get_global_ctx()
+        preview = getattr(ctx.batch, "clover_preview", False)
+        if preview or getattr(ctx.batch, "clover_transactions", None) is not None:
+            from .preview import block_forward
+
+            return block_forward(self, ctx, preview=preview)
+        return super().forward()
