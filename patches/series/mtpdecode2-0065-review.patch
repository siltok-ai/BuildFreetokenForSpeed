+def test_verify_conv_graph_matches_decode_and_every_prefix(count, snapshots, strided):
+    """直接对照既有逐行 decode，核对所有状态并重放新的输入和 live slot。"""
+    from freetoken.kernel.causal_conv1d import causal_conv1d_decode
