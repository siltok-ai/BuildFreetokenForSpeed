index 0000000..a55ce31
--- /dev/null
+++ b/tests/moe/test_q2_0.py
@@ -0,0 +1,48 @@
+"""External expert overrides must preserve the trunk's independent schemes."""
+from dataclasses import replace
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from freetoken.layers.quantization import QuantConfig, QuantKind
+from freetoken.layers.quantization.configs.base import ExpertSourceConfig, NoQuantConfig
+from freetoken.layers.quantization.moe.base import MoEConfig
+from freetoken.layers.quantization.moe.q2_0 import Q20MoEMethod
+from freetoken.layers.quantization.names import NameMap
+
+
+def test_q2_override_preserves_trunk_and_shared_experts():
+    quant = ExpertSourceConfig(NoQuantConfig(NameMap(roots=(("model.layers", "model.language_model.layers"),))))
+    for name in ("model.layers.0.self_attn.q_proj", "model.layers.0.mlp.shared_expert.gate_up_proj",
+                 "model.layers.0.mlp.shared_expert_gate", "model.layers.0.mlp.gate", "lm_head"):
+        assert quant.scheme_for(name) is None
+    scheme = quant.scheme_for("model.layers.0.mlp.experts")
+    assert scheme.kind is QuantKind.Q2_0
+    assert quant.scheme_for_name("model.language_model.layers.0.mlp.experts.511.down_proj") == scheme
+
+
+def test_q2_layout_packing_preserves_expert_rows_without_expansion():
+    cfg = MoEConfig(num_experts=3, hidden=64, intermediate=64, top_k=2, strategy="offload")
+    method = Q20MoEMethod(cfg)
+    layout = method.layout()
+    assert sum(torch.empty(spec.shape, dtype=spec.dtype).numel() for spec in layout.values()) == 3 * 64 * 64 // 64 * 18
+    pieces = {role: torch.randint(0, 256, (3, 64, 18), dtype=torch.uint8) for role in ("gate", "up", "down")}
+    out = {role: torch.empty((3, *spec.shape), dtype=spec.dtype) for role, spec in layout.items()}
+    method.pack(pieces, out)
+    torch.testing.assert_close(out["gate_up"][:, :64], pieces["gate"], rtol=0, atol=0)
+    torch.testing.assert_close(out["gate_up"][:, 64:], pieces["up"], rtol=0, atol=0)
+    torch.testing.assert_close(out["down"], pieces["down"], rtol=0, atol=0)
+    assert method.cpu_format is None
+    for changes in ({"decode_target": "cpu"}, {"strategy": "resident"}, {"hidden": 65},
+                    {"dtype": torch.float16}, {"apply_router_weight_on_input": True}):
+        with pytest.raises(RuntimeError):
+            Q20MoEMethod(replace(cfg, **changes))
+
+
+def test_q2_source_is_explicit_and_architecture_scoped():
+    config = SimpleNamespace(model_type="qwen4_exp", freetoken_expert_source={"format": "q2_0"})
+    assert QuantConfig.from_hf(config).scheme_for("model.layers.0.mlp.experts").kind is QuantKind.Q2_0
+    config.model_type = "qwen3_5_moe"
+    with pytest.raises(ValueError):
+        QuantConfig.from_hf(config)
diff --git a/tests/moe/test_q2_source.py b/tests/moe/test_q2_source.py
new file mode 100644
index 0000000..187fefa
--- /dev/null
+++ b/tests/moe/test_q2_source.py
@@ -0,0 +1,82 @@
+"""Exercise a real miniature GSQ Q2_0 GGUF, including expert order and corruption."""
+import hashlib
+import struct
+from types import SimpleNamespace
+
+import pytest
+
+from freetoken.models.qwen4_exp.q2_source import iter_q2_expert_pieces, read_q2_directory
+
+
+def _string(value):
+    data = value.encode()
+    return struct.pack('<Q', len(data)) + data
+
+
+def _source(path, *, kind=42, overlap=False):
+    """生成有独立角色/专家标记的真实 GGUF；期望值由写入的原始字节给出。"""
+    metadata = {'general.architecture': 'qwen4exp', 'qwen4exp.block_count': 2,
+                'qwen4exp.expert_count': 3, 'qwen4exp.embedding_length': 64,
+                'qwen4exp.expert_feed_forward_length': 128}
+    header = struct.pack('<IIQQ', 0x46554747, 3, 6, len(metadata))
+    for name, value in metadata.items():
+        header += _string(name)
+        header += struct.pack('<I', 8) + _string(value) if isinstance(value, str) else struct.pack('<II', 4, value)
+    payload, expected = bytearray(), {}
+    for layer in range(2):
+        for role_index, role in enumerate(('gate', 'up', 'down')):
+            payload.extend(b'\0' * (-len(payload) % 32))
+            offset = 0 if overlap else len(payload)
+            shape = (128, 64, 3) if role == 'down' else (64, 128, 3)
+            header += (_string(f'blk.{layer}.ffn_{role}_exps.weight') + struct.pack('<I', 3)
+                       + struct.pack('<QQQIQ', *shape, kind, offset))
+            for expert in range(3):
+                data = bytes([1 + layer * 20 + role_index * 4 + expert]) * 2304
+                payload.extend(data)
+                expected[layer, role, expert] = data
+    header += b'\0' * (-len(header) % 32)
+    path.write_bytes(header + payload)
+    source = {'format': 'q2_0', 'scope': 'routed_experts_only', 'path': path.name,
+              'sha256': hashlib.sha256(path.read_bytes()).hexdigest(), 'size': path.stat().st_size,
+              'verified_mtime_ns': path.stat().st_mtime_ns, 'layers': 2, 'experts_per_layer': 3,
+              'hidden': 64, 'intermediate': 128, 'expert_bytes': 41472}
+    config = SimpleNamespace(expert_source=source, num_layers=2, num_experts=3,
+                             hidden_size=64, moe_intermediate_size=128)
+    return config, expected
+
+
+def test_all_experts_stream_with_model_geometry_and_alternate_identity(tmp_path):
+    path = tmp_path / 'small.gguf'
+    config, expected = _source(path)
+    batches = list(iter_q2_expert_pieces(tmp_path, config, chunk=15000))
+    assert [(layer, start, end) for layer, start, end, _ in batches] == [(0, 0, 2), (0, 2, 3), (1, 0, 2), (1, 2, 3)]
+    for layer, start, end, pieces in batches:
+        for role, tensor in pieces.items():
+            for index, expert in enumerate(range(start, end)):
+                assert tensor[index].numpy().tobytes() == expected[layer, role, expert]
+
+
+@pytest.mark.parametrize('change,match', [('kind', 'incompatible'), ('overlap', 'overlapping'),
+                                        ('truncated', 'out-of-bounds'), ('geometry', 'geometry mismatch')])
+def test_invalid_directory_is_rejected(tmp_path, change, match):
+    path = tmp_path / 'small.gguf'
+    _source(path, kind=10 if change == 'kind' else 42, overlap=change == 'overlap')
+    if change == 'truncated':
+        path.write_bytes(path.read_bytes()[:-1])
+    with pytest.raises(ValueError, match=match):
+        read_q2_directory(path, layers=2, experts=4 if change == 'geometry' else 3, hidden=64, intermediate=128)
+
+
+def test_source_change_requires_reverification(tmp_path):
+    path = tmp_path / 'small.gguf'
+    config, _ = _source(path)
+    config.expert_source['verified_mtime_ns'] -= 1
+    with pytest.raises(ValueError, match='identity changed'):
+        list(iter_q2_expert_pieces(tmp_path, config))
+
+
+def test_receipt_geometry_cannot_override_model(tmp_path):
+    config, _ = _source(tmp_path / 'small.gguf')
+    config.expert_source['experts_per_layer'] = 2
+    with pytest.raises(ValueError, match='model geometry'):
+        list(iter_q2_expert_pieces(tmp_path, config))
