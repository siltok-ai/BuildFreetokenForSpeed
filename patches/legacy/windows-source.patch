+import runpy
+
+import torch.utils.cpp_extension as cpp_extension
+
+
+def main():
+    """保留 Torch 编译器检查，仅修正无控制台进程的 MSVC 输出解码。"""
+    root = Path(__file__).resolve().parents[1]
+    os.chdir(root)
+    cpp_extension.SUBPROCESS_DECODE_ARGS = ("utf-8", "replace")
