+++ b/tools/run_when_weights_ready.py
@@ -0,0 +1,98 @@
+"""等待下载的真实分片完整，核对大小和布局后自动执行无效专家模型的 smoke/benchmark。"""
+
+import argparse
+from datetime import datetime
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import sys
+import time
+
+
+def main():
+    """下载和推理依次执行；任何校验或推理失败保留日志并停止，不伪造成功结果。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--metadata", type=Path, required=True)
+    parser.add_argument("--cache", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--timeout-hours", type=float, default=6)
+    args = parser.parse_args()
+    source = json.loads((args.metadata / "research-source.json").read_text(encoding="utf-8"))
+    sizes = {entry["Path"]: entry["Size"] for entry in source["files"]}
+    marker = json.loads((args.model / "INVALID-EXPERT-ALIASES.json").read_text(encoding="utf-8"))
+    selected = marker["selected_shards"]
+    root = Path(__file__).resolve().parents[1]
+    args.output.mkdir(parents=True, exist_ok=True)
+    status = {"status": "waiting_for_download", "started": datetime.now().astimezone().isoformat(),
+              "model": str(args.model), "INVALID_MODEL": True, "total_files": len(selected)}
+
+    def save():
+        status["updated"] = datetime.now().astimezone().isoformat()
+        path = args.output / "automatic-validation-status.json"
+        temporary = path.with_suffix(".tmp")
+        temporary.write_text(json.dumps(status, indent=2) + "\n", encoding="utf-8")
+        temporary.replace(path)
+
+    began = time.monotonic()
+    try:
+        while True:
+            complete = [name for name in selected if (args.model / name).is_file()
+                        and (args.model / name).stat().st_size == sizes[name]]
+            status["complete_files"] = len(complete)
+            status["complete_bytes"] = sum(sizes[name] for name in complete)
+            try:
+                current = json.loads((args.model / "INVALID-EXPERT-ALIASES.json").read_text(encoding="utf-8"))
+                downloaded = {entry["name"] for entry in current["completed"]}
+                verified = {entry["name"] for entry in current["completed"] if len(entry.get("sha256", "")) == 64}
+            except json.JSONDecodeError:
+                # 下载器旧进程原地写清单时，下一轮重新读取；不提前进入生成。
+                verified = set()
+                downloaded = set()
+            status["sdk_download_completed_files"] = len(downloaded.intersection(selected))
+            status["sha256_verified_files"] = len(verified.intersection(selected))
+            save()
+            if len(complete) == len(selected) and set(selected) <= verified:
+                break
+            if time.monotonic() - began > args.timeout_hours * 3600:
+                raise TimeoutError("weights are not ready before the automatic validation deadline")
+            time.sleep(20)
+        status["status"] = "validating_checkpoint_layout"
+        save()
+        index = (args.model / "model.safetensors.index.json").read_bytes()
+        if hashlib.sha256(index).hexdigest() != marker["index_sha256"]:
+            raise ValueError("checkpoint index changed since the experiment download plan")
+        # master 非不可变 revision：核对实际张量布局与研究阶段读取的远端 header。
+        for name in selected:
+            expected = json.loads((args.metadata / "research-headers" / (name + ".json")).read_text(encoding="utf-8"))
+            with (args.model / name).open("rb") as file:
+                header_size = struct.unpack("<Q", file.read(8))[0]
+                actual = json.loads(file.read(header_size))
+            if actual != expected:
+                raise ValueError(f"checkpoint tensor layout changed: {name}")
+        status["validated_shards"] = len(selected)
+        common = [sys.executable, str(root / "tools" / "benchmark_alias40.py"),
+                  "--model", str(args.model), "--cache", str(args.cache)]
+        for stage, extra in (("smoke", ["--prompt-tokens", "128", "--output-tokens", "32", "--repeats", "1", "--collect-cache-stats"]),
+                             ("benchmark", ["--prompt-tokens", "128", "1024", "--output-tokens", "128", "--repeats", "2"])):
+            status["status"] = "running_" + stage
+            save()
+            with (args.output / ("alias40-" + stage + ".log")).open("w", encoding="utf-8") as log:
+                result = subprocess.run(common + ["--report", str(args.output / ("alias40-" + stage + ".json"))] + extra,
+                                        cwd=root, stdout=log, stderr=subprocess.STDOUT)
+            status[stage + "_exit_code"] = result.returncode
+            if result.returncode:
+                raise RuntimeError(f"{stage} exited with {result.returncode}; inspect alias40-{stage}.log")
+        status["status"] = "complete"
+    except BaseException as exc:
+        status["status"] = "failed"
+        status["error"] = {"type": type(exc).__name__, "message": str(exc)}
+        raise
+    finally:
+        save()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/verify_experiment_download.py b/tools/verify_experiment_download.py
new file mode 100644
--- /dev/null
+++ b/tools/verify_experiment_download.py
@@ -0,0 +1,69 @@
+"""从 ModelScope 完整文件元数据取得 SHA-256，核对实验中所有已下载分片。"""
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor, as_completed
+from datetime import datetime
+import hashlib
+import json
+from pathlib import Path
+
+
+def main():
+    """兼容接口丢弃 SHA 字段，因此显式读取新 API 并执行本地全文件哈希。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument("--workers", type=int, default=2)
+    args = parser.parse_args()
+    from modelscope_hub import HubApi
+    marker_path = args.model / "INVALID-EXPERT-ALIASES.json"
+    marker = json.loads(marker_path.read_text(encoding="utf-8"))
+    files = HubApi().list_repo_files(marker["model_id"], "model", revision=marker["revision"])
+    selected = set(marker["selected_shards"])
+    entries = {file.path: {"name": file.path, "bytes": file.size, "sha256": file.sha256}
+               for file in files if file.path in selected}
+    if set(entries) != selected or any(not item["sha256"] or len(item["sha256"]) != 64 for item in entries.values()):
+        raise ValueError("remote metadata lacks one or more selected shards' SHA-256")
+    report = {"status": "verifying", "started": datetime.now().astimezone().isoformat(),
+              "model_id": marker["model_id"], "revision": marker["revision"], "verified": []}
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.with_name("download-remote-sha256.json").write_text(
+        json.dumps(list(entries.values()), indent=2) + "\n", encoding="utf-8")
+
+    def verify(item):
+        path = args.model / item["name"]
+        if path.stat().st_size != item["bytes"]:
+            raise ValueError(f"download size differs: {item['name']}")
+        with path.open("rb") as file:
+            actual = hashlib.file_digest(file, "sha256").hexdigest()
+        if actual != item["sha256"]:
+            raise ValueError(f"download SHA-256 differs: {item['name']}")
+        return item
+
+    try:
+        with ThreadPoolExecutor(max_workers=args.workers) as pool:
+            tasks = [pool.submit(verify, entries[name]) for name in sorted(selected)]
+            for task in as_completed(tasks):
+                report["verified"].append(task.result())
+                args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+                print(f"SHA-256 verified {len(report['verified'])}/{len(selected)}", flush=True)
+        by_name = {item["name"]: item for item in report["verified"]}
+        for completed in marker["completed"]:
+            completed["sha256"] = by_name[completed["name"]]["sha256"]
+        marker["checksum_verification"] = "All selected shards match ModelScope SHA-256"
+        marker["sha256_verified_at"] = datetime.now().astimezone().isoformat()
+        temporary = marker_path.with_suffix(".tmp")
+        temporary.write_text(json.dumps(marker, indent=2) + "\n", encoding="utf-8")
+        temporary.replace(marker_path)
+        report["status"] = "complete"
+        report["verified_bytes"] = sum(item["bytes"] for item in report["verified"])
+    except BaseException as exc:
+        report["status"] = "failed"
+        report["error"] = {"type": type(exc).__name__, "message": str(exc)}
+        raise
+    finally:
+        args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
