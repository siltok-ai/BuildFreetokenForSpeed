@@ -0,0 +1,92 @@
+"""执行 Flash-Next 实际规格的预编译 DLL 并核对数据，禁止 JIT fallback。"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+
+
+def main():
+    """用真实 GPU/registered host buffers 核查 Windows AOT 的数值与复制语义。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--cache", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "python"))
+    os.environ["FREETOKEN_KERNEL_CACHE_DIR"] = str(args.cache.resolve())
+    os.environ["FREETOKEN_DISABLE_JIT"] = "1"
+    import torch
+    from freetoken.kernel.batch_memcpy import load_batch_memcpy
+    from freetoken.kernel.fast_index_copy import fast_index_copy_jit, fast_index_copy_multi_jit, update_copy_flag_jit
+    from freetoken.kernel.index import indexing
+    from freetoken.kernel.pinned import device_ptr
+    from freetoken.kernel.radix import fast_compare_key
+    from freetoken.kernel.store import store_cache
+    from freetoken.moe.host_banks import HostBank
+
+    verified = []
+    weights = torch.randn(17, 2560, dtype=torch.bfloat16, device="cuda")
+    indices = torch.tensor([16, 0, 5], dtype=torch.int32, device="cuda")
+    torch.testing.assert_close(indexing(weights, indices), weights[indices.long()], rtol=0, atol=0)
+    verified.append("index_5120_2_128_1_false")
+    k_cache = torch.zeros(32, 2, 256, dtype=torch.bfloat16, device="cuda")
+    v_cache = torch.zeros_like(k_cache)
+    k, v = torch.randn(2, 3, 2, 256, dtype=torch.bfloat16, device="cuda")
+    loc = torch.tensor([3, 7, 31], dtype=torch.int32, device="cuda")
+    store_cache(k_cache, v_cache, loc, k.flatten(1), v.flatten(1))
+    torch.testing.assert_close(k_cache[loc.long()], k, rtol=0, atol=0)
+    torch.testing.assert_close(v_cache[loc.long()], v, rtol=0, atol=0)
+    verified.append("store_1024_128_1_false")
+    for dtype in (torch.int32, torch.int64):
+        key = torch.tensor([7, 8, 9, 10], dtype=dtype)
+        assert fast_compare_key(key, key.clone()) == 4
+        assert fast_compare_key(key, torch.tensor([7, 8, 0, 10], dtype=dtype)) == 2
+    verified.append("radix")
+    load_batch_memcpy()
+    verified.append("batch_memcpy")
+    flag = torch.zeros(1, dtype=torch.int32, device="cuda")
+    update_copy_flag_jit(flag, 7)
+    update_copy_flag_jit(flag, -2)
+    assert flag.item() == 5
+    verified.append("fast_index_copy_update_flag")
+    features = [2560, 5120, 102400, 204800, 819200, 1638400]
+    sources, destinations = [], []
+    dst_ids = torch.tensor([1, 3], dtype=torch.int32, device="cuda")
+    src_ids = torch.tensor([2, 0], dtype=torch.int32, device="cuda")
+    count = torch.tensor([2], dtype=torch.int64, device="cuda")
+    for size in features:
+        bank = HostBank((4, size), torch.uint8)
+        for row in range(4):
+            bank.tensor[row].fill_(17 + row)
+        bank.pin()
+        destination = torch.zeros(4, size, dtype=torch.uint8, device="cuda")
+        fast_index_copy_jit(destination, dst_ids, bank.tensor, src_ids, count)
+        torch.cuda.synchronize()
+        assert torch.equal(destination[dst_ids.long()].cpu(), bank.tensor[src_ids.cpu().long()])
+        assert not destination[[0, 2]].any()
+        sources.append(bank.tensor)
+        destinations.append(destination)
+        verified.append("fast_index_copy_" + str(size))
+    dst_ptrs = torch.tensor([t.data_ptr() for t in destinations], dtype=torch.int64, device="cuda")
+    src_ptrs = torch.tensor([device_ptr(t) for t in sources], dtype=torch.int64, device="cuda")
+    byte_counts = torch.tensor(features, dtype=torch.int64, device="cuda")
+    for blocks in (8, 64):
+        for destination in destinations:
+            destination.zero_()
+        fast_index_copy_multi_jit(dst_ptrs, src_ptrs, byte_counts, dst_ids, src_ids, count, blocks_per_bank=blocks)
+        torch.cuda.synchronize()
+        for source, destination in zip(sources, destinations):
+            assert torch.equal(destination[dst_ids.long()].cpu(), source[src_ids.cpu().long()])
+            assert not destination[[0, 2]].any()
+        verified.append("fast_index_copy_multi_1024_" + str(blocks))
+    result = {"status": "complete", "jit_disabled": True, "verified_modules": verified,
+              "module_count": len(verified), "torch": torch.__version__, "gpu": torch.cuda.get_device_name()}
+    assert len(verified) == 13
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/probe_real_ssd_ngram.py b/tools/probe_real_ssd_ngram.py
new file mode 100644
--- /dev/null
+++ b/tools/probe_real_ssd_ngram.py
@@ -0,0 +1,67 @@
+"""验证真实多 GiB ngram safetensors 在 Windows 的 SSD 定位读取与 64 位偏移。"""
+
+import argparse
+import json
+from pathlib import Path
+import re
+import struct
+import sys
+
+
+def main():
+    """按实际 header 建 extent，以原生 RowStore 读取少量真实行并与直接文件字节比较。"""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--shard", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "python"))
+    import psutil
+    import torch
+    from freetoken.kernel.pinned import alloc_pinned_tensor
+    from freetoken.kernel.row_store import RowStore
+
+    with args.shard.open("rb") as file:
+        header_size = struct.unpack("<Q", file.read(8))[0]
+        header = json.loads(file.read(header_size))
+    table_parts = sorted(((int(re.search(r"shard_(\d+)\.weight$", key)[1]), meta)
+                          for key, meta in header.items() if re.search(r"ngram_embedding\.shard_\d+\.weight$", key)))
+    shape = table_parts[0][1]["shape"]
+    assert all(meta["shape"] == shape and meta["dtype"] == "F8_E4M3" for _, meta in table_parts)
+    rows, width = shape
+    bases = [8 + header_size + meta["data_offsets"][0] for _, meta in table_parts]
+    torch.cuda.init()
+    warm = alloc_pinned_tensor(4096, dtype=torch.uint8)
+    warm.zero_()
+    process = psutil.Process()
+    before = process.memory_info().rss
+    store = RowStore(paths=[str(args.shard.resolve())], extent_file=[0] * len(bases),
+                     extent_base=bases, rows_per_extent=rows, row_bytes=width,
+                     row_stride=width, use_io_uring=False)
+    ids = torch.tensor([extent * rows + offset for extent in range(len(bases))
+                        for offset in (0, rows // 2, rows - 1)], dtype=torch.int64)
+    staging = alloc_pinned_tensor(ids.numel() * width, dtype=torch.uint8)
+    store.stage_rows(ids.data_ptr(), ids.numel(), staging.data_ptr())
+    store.flush(0)
+    oracle = bytearray()
+    with args.shard.open("rb") as file:
+        for row in ids.tolist():
+            file.seek(bases[row // rows] + (row % rows) * width)
+            payload = file.read(width)
+            assert len(payload) == width
+            oracle.extend(payload)
+    assert staging.numpy().tobytes() == bytes(oracle)
+    stats = store.io_stats()
+    assert stats["direct_files"] == stats["files"] == 1
+    assert stats["largest_read_offset"] > 2**32
+    result = {"checkpoint_shard": str(args.shard.resolve()), "file_bytes": args.shard.stat().st_size,
+              "io_backend": store.io_backend(), "io_stats": stats,
+              "extents": len(bases), "row_bytes": width, "staging_pinned_bytes": staging.nbytes,
+              "rows_bitwise_verified": ids.numel(), "largest_offset_exceeds_4GiB": True,
+              "process_rss_growth_bytes": process.memory_info().rss - before}
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/run_when_weights_ready.py b/tools/run_when_weights_ready.py
new file mode 100644
